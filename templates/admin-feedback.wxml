<include src="feedback.wxml" />
<view id="shared-dialog-mask" class="admin-drawer-mask {{_adminDialogClosing ? 'drawer-closing' : ''}}" wx:if="{{_adminDialogVisible}}" bindtap="onAdminDrawerMaskTap" data-close="onAdminDialogCancel"><view class="drawer-backdrop" id="shared-dialog-mask-backdrop" bindtap="onAdminDrawerMaskTap" catchtouchmove="adminDrawerNoop" data-close="onAdminDialogCancel" /><form class="admin-drawer" bindsubmit="onAdminDialogConfirm" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="onAdminDialogCancel"><view class="drawer-handle" data-drawer-drag="true" catchtouchmove="adminDrawerNoop" /><text class="modal-title" data-drawer-drag="true" catchtouchmove="adminDrawerNoop">{{_adminDialogTitle}}</text><text class="drawer-description" wx:if="{{_adminDialogContent}}" data-drawer-drag="true" catchtouchmove="adminDrawerNoop">{{_adminDialogContent}}</text><scroll-view class="dialog-choice-scroll" scroll-y wx:if="{{_adminDialogChoices.length}}"><view class="drawer-menu"><button class="drawer-menu-row" wx:for="{{_adminDialogChoices}}" wx:key="index" bindtap="onAdminDialogChoice" data-index="{{index}}"><text>{{item.label}}</text><view class="dialog-choice-dot {{_adminDialogChoiceIndex === index ? 'selected' : ''}}" /></button></view></scroll-view><view class="date-wheel-shell" wx:if="{{_adminDialogDate}}"><picker-view class="dialog-date-wheel" wx:if="{{_adminDialogDate}}" value="{{_adminDateValue}}" bindchange="onAdminDateChange" bindpickstart="onAdminDateStart" bindpickend="onAdminDateEnd" indicator-class="date-wheel-native-indicator" indicator-style="height:88rpx;border:none;background:transparent;box-shadow:none;" mask-style="background-image:none;background-color:transparent;"><picker-view-column><view class="date-wheel-item {{index === _adminDateValue[0] ? 'selected' : ''}}" wx:for="{{_adminDateYears}}" wx:key="*this"><text class="date-wheel-number">{{item}}</text></view></picker-view-column><picker-view-column><view class="date-wheel-item {{index === _adminDateValue[1] ? 'selected' : ''}}" wx:for="{{_adminDateMonths}}" wx:key="*this"><text class="date-wheel-number">{{item}}</text></view></picker-view-column><picker-view-column><view class="date-wheel-item {{index === _adminDateValue[2] ? 'selected' : ''}}" wx:for="{{_adminDateDays}}" wx:key="*this"><text class="date-wheel-number">{{item}}</text></view></picker-view-column></picker-view><view class="date-wheel-fade top" /><view class="date-wheel-fade bottom" /><view class="date-wheel-units" aria-hidden="true"><view><text>年</text></view><view><text>月</text></view><view><text>日</text></view></view></view><input wx:if="{{_adminDialogEditable}}" class="dialog-input" name="adminDialogInput" id="keyboard-dialog" data-keyboard-target="#keyboard-dialog" data-keyboard-layer="overlay" bindfocus="onKeyboardFieldFocus" bindblur="onKeyboardFieldBlur" value="{{_adminDialogInput}}" bindinput="onAdminDialogInput" placeholder="{{_adminDialogPlaceholder}}" placeholder-class="form-placeholder" maxlength="300"  adjust-position="{{false}}" cursor-spacing="24" /><view class="modal-actions"><button class="btn-cancel" wx:if="{{_adminDialogCancel}}" bindtap="onAdminDialogCancel">{{_adminDialogCancelText}}</button><button class="btn-confirm {{_adminDialogDestructive ? 'dialog-danger' : ''}}" wx:if="{{!_adminDialogChoices.length}}" form-type="submit" disabled="{{_adminDialogDate && _adminDateMoving}}">{{_adminDialogConfirmText}}</button></view></form></view>
