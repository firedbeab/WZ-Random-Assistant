<view class="admin-feedback-layer {{_adminFeedbackMask ? 'masked' : ''}}" wx:if="{{_adminFeedbackLoading}}" aria-live="polite"><view class="admin-loading-card"><view class="admin-loading-dots"><view /><view /><view /></view><text>{{_adminFeedbackTitle}}</text></view></view>
<view class="admin-message {{_adminFeedbackKind}}" wx:if="{{_adminFeedbackMessage}}" aria-live="polite"><view /><text>{{_adminFeedbackMessage}}</text></view>
<view id="shared-dialog-mask" class="admin-drawer-mask {{_adminDialogClosing ? 'drawer-closing' : ''}}" wx:if="{{_adminDialogVisible}}" bindtap="onAdminDrawerMaskTap" data-close="onAdminDialogCancel"><form class="admin-drawer" bindsubmit="onAdminDialogConfirm" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="onAdminDialogCancel"><view class="drawer-handle" data-drawer-drag="true" /><text class="modal-title" data-drawer-drag="true">{{_adminDialogTitle}}</text><text class="drawer-description" wx:if="{{_adminDialogContent}}" data-drawer-drag="true">{{_adminDialogContent}}</text><scroll-view class="dialog-choice-scroll" scroll-y wx:if="{{_adminDialogChoices.length}}"><view class="drawer-menu"><button class="drawer-menu-row" wx:for="{{_adminDialogChoices}}" wx:key="index" bindtap="onAdminDialogChoice" data-index="{{index}}"><text>{{item.label}}</text><view class="dialog-choice-dot {{_adminDialogChoiceIndex === index ? 'selected' : ''}}" /></button></view></scroll-view><picker-view class="dialog-date-wheel" wx:if="{{_adminDialogDate}}" value="{{_adminDateValue}}" bindchange="onAdminDateChange" bindpickstart="onAdminDateStart" bindpickend="onAdminDateEnd" indicator-style="height:88rpx;border-top:1rpx solid {{themeColors.line}};border-bottom:1rpx solid {{themeColors.line}};" mask-style="background-image:linear-gradient(to bottom,{{themeColors.surface}} 0%,transparent 35%,transparent 65%,{{themeColors.surface}} 100%);"><picker-view-column><view class="date-wheel-item {{index === _adminDateValue[0] ? 'selected' : ''}}" wx:for="{{_adminDateYears}}" wx:key="*this">{{item}} 年</view></picker-view-column><picker-view-column><view class="date-wheel-item {{index === _adminDateValue[1] ? 'selected' : ''}}" wx:for="{{_adminDateMonths}}" wx:key="*this">{{item}} 月</view></picker-view-column><picker-view-column><view class="date-wheel-item {{index === _adminDateValue[2] ? 'selected' : ''}}" wx:for="{{_adminDateDays}}" wx:key="*this">{{item}} 日</view></picker-view-column></picker-view><input wx:if="{{_adminDialogEditable}}" class="dialog-input" name="adminDialogInput" value="{{_adminDialogInput}}" bindinput="onAdminDialogInput" placeholder="{{_adminDialogPlaceholder}}" placeholder-class="form-placeholder" maxlength="300" /><view class="modal-actions"><button class="btn-cancel" wx:if="{{_adminDialogCancel}}" bindtap="onAdminDialogCancel">{{_adminDialogCancelText}}</button><button class="btn-confirm {{_adminDialogDestructive ? 'dialog-danger' : ''}}" wx:if="{{!_adminDialogChoices.length}}" form-type="submit" disabled="{{_adminDialogDate && _adminDateMoving}}">{{_adminDialogConfirmText}}</button></view></form></view>
