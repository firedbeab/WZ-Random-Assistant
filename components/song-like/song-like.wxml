<button class="like {{liked ? 'selected' : ''}} {{pending ? 'pending' : ''}} {{pending || (ready && !interactive && !failed) ? 'is-disabled' : ''}}" style="{{appearanceStyle}}" catchtap="tap" catchlongpress="noop" disabled="{{pending || (ready && !interactive && !failed)}}" aria-label="{{failed ? '点赞读取失败，点击重试' : !ready ? '正在读取点赞' : (interactive ? (liked ? '取消点赞' : '点赞') : '最终点赞数') + '，' + count + '人'}}" aria-pressed="{{liked}}" hover-class="like-pressed">
 <image class="like-icon" src="{{liked ? themeIcons.heartFilled : themeIcons.heart}}" mode="aspectFit" aria-hidden="true"/><text>{{failed ? '重试' : ready ? count : '…'}}</text>
</button>
