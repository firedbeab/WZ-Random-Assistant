.like{display:flex;align-items:center;justify-content:center;gap:8rpx;min-width:88rpx;min-height:80rpx;padding:12rpx 8rpx;margin:0;background:transparent;color:var(--text-3);font-size:23rpx;line-height:1.4;border:0;border-radius:14rpx;transition:color 180ms,background-color 180ms}.like::after{border:0}.like image{width:32rpx;height:32rpx;flex:none}.like.selected{color:var(--accent)}.like.pending{opacity:.75}.like[disabled]:not([type]){color:var(--text-3);background:transparent}.like.selected[disabled]:not([type]){color:var(--accent)}.like-pressed{background:var(--accent-weak)}
