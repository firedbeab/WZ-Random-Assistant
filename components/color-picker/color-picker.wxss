.picker { padding: 12rpx 0; }.picker-plane { position: relative; height: 260rpx; margin: 12rpx; border-radius: 16rpx; touch-action: none; }.picker-white,.picker-black { position: absolute; inset: 0; border-radius: inherit; pointer-events: none; }.picker-white { background: linear-gradient(90deg,#fff,rgba(255,255,255,0)); }.picker-black { background: linear-gradient(0deg,#000,rgba(0,0,0,0)); }.picker-thumb,.hue-thumb { position: absolute; width: 28rpx; height: 28rpx; border: 4rpx solid #fff; box-shadow: 0 0 0 2rpx rgba(0,0,0,.35); border-radius: 50%; transform: translate(-50%,-50%); pointer-events: none; }.picker-hue { position: relative; height: 32rpx; margin: 32rpx 12rpx 16rpx; border-radius: 18rpx; background: linear-gradient(90deg,#f00,#ff0,#0f0,#0ff,#00f,#f0f,#f00); }.hue-thumb { top: 50%; }.picker-code { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; }.picker-code > view { flex: none; width: 56rpx; height: 56rpx; border: 1rpx solid var(--line-strong); border-radius: 12rpx; }.picker-code input { flex: 1; min-width: 0; height: 88rpx; box-sizing: border-box; padding: 0 20rpx; color: var(--text-1); background: var(--surface-2); border-radius: 16rpx; font-size: 28rpx; }
