.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--mask);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-card {
  width: 620rpx;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
}

.privacy-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 32rpx;
}

.privacy-body {
  margin-bottom: 40rpx;
}

.privacy-text {
  font-size: 28rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.privacy-link {
  font-size: 28rpx;
  color: var(--info);
  line-height: 1.7;
}

.privacy-detail {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--surface-2);
  border-radius: 12rpx;
}

.privacy-detail-title {
  font-size: 26rpx;
  color: var(--text-3);
  display: block;
  margin-bottom: 12rpx;
}

.privacy-detail-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.privacy-dot {
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  background: var(--text-3);
  border-radius: 50%;
  margin-top: 14rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.privacy-detail-text {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
}

.privacy-btns {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 24rpx;
}

.btn-reject {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-3);
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 0;
  margin: 0;
}

.btn-reject::after {
  border: none;
}

.btn-agree {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--on-accent);
  background: var(--accent);
  border: none;
  border-radius: 12rpx;
  padding: 0;
  margin: 0;
}

.btn-agree::after {
  border: none;
}
