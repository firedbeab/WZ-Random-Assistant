/* 公共排版与几何变量；色值来源为 utils/theme.js。 */
page {
  --gradient-page: linear-gradient(180deg, var(--gradient-open-start) 0px, var(--gradient-open-mid) 180px, var(--bg) 420px);
  --gradient-open: var(--gradient-page);
  --gradient-closed: var(--gradient-page);
  --font-xs: 20rpx;
  --font-code: 'Courier New', Courier, monospace;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-song: 34rpx;
  --font-xl: 38rpx;
  --font-2xl: 46rpx;
  --font-3xl: 64rpx;
  --radius-sm: 8rpx;
  --radius-md: 14rpx;
  --radius-lg: 20rpx;
  --radius-pill: 999rpx;
  --space-1: 8rpx;
  --space-2: 12rpx;
  --space-3: 16rpx;
  --space-4: 24rpx;
  --space-5: 32rpx;
  --space-6: 48rpx;
}
