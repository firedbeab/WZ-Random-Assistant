/* 由 utils/theme.js 生成；运行 node Progress/build-theme.cjs，勿单独改色值。 */
page {
  --bg: #f4f2ef;
  --surface: #ffffff;
  --surface-2: #edebe7;
  --surface-3: #e2e5df;
  --line: #e0e3dc;
  --line-strong: #c6cec5;
  --text-1: #1b1b1d;
  --text-2: #5f6066;
  --text-3: #686b63;
  --placeholder: #686b63;
  --text-disabled: #777e75;
  --mask: rgba(0, 0, 0, .5);
  --on-overlay: #ffffff;
  --surface-translucent: rgba(255, 255, 255, .96);
  --shadow-sm: 0 2rpx 8rpx rgba(60, 50, 40, .05);
  --shadow-md: 0 8rpx 24rpx rgba(60, 50, 40, .08);
  --shadow-dialog: 0 26rpx 90rpx rgba(0, 0, 0, .18);
  --accent: #28764f;
  --accent-weak: #e8f2ec;
  --accent-pressed: #246a48;
  --accent-disabled: #8aab98;
  --on-accent: #ffffff;
  --gradient-open-start: #e2efe7;
  --gradient-open-mid: #eef1ea;
  --gradient-closed-start: #eceae5;
  --gradient-closed-mid: #f0eeea;
  --focus-ring: 0 0 0 4rpx rgba(40, 118, 79, .22);
  --success: #217346;
  --success-weak: #e8f2ec;
  --on-success: #ffffff;
  --danger: #bd3535;
  --danger-weak: #fbeceb;
  --on-danger: #ffffff;
  --warn: #805711;
  --warn-weak: #fdf3e3;
  --on-warn: #ffffff;
  --info: #2f6fb3;
  --info-weak: #eaf1fa;
  --on-info: #ffffff;
  --carryover: #72509e;
  --carryover-weak: #f3eaf9;
}
@media (prefers-color-scheme: dark) {
  page {
    --bg: #141a16;
    --surface: #1f2722;
    --surface-2: #2a352e;
    --surface-3: #344139;
    --line: #3d4b41;
    --line-strong: #59695c;
    --text-1: #f1f3ef;
    --text-2: #c0c9c0;
    --text-3: #a5b2a6;
    --placeholder: #a5b2a6;
    --text-disabled: #9caaa0;
    --mask: rgba(0, 0, 0, .72);
    --on-overlay: #ffffff;
    --surface-translucent: rgba(31, 39, 34, .96);
    --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, .2);
    --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, .28);
    --shadow-dialog: 0 26rpx 90rpx rgba(0, 0, 0, .5);
    --accent: #7ed5a1;
    --accent-weak: #233d2e;
    --accent-pressed: #a0e2b9;
    --accent-disabled: #4c6d58;
    --on-accent: #102218;
    --gradient-open-start: #1c2b22;
    --gradient-open-mid: #18231c;
    --gradient-closed-start: #1a211c;
    --gradient-closed-mid: #171e19;
    --focus-ring: 0 0 0 4rpx rgba(126, 213, 161, .3);
    --success: #81d9a3;
    --success-weak: #233d2e;
    --on-success: #102218;
    --danger: #ffaaa5;
    --danger-weak: #432a29;
    --on-danger: #301311;
    --warn: #efc77b;
    --warn-weak: #3b311e;
    --on-warn: #2d210b;
    --info: #99c5f3;
    --info-weak: #233346;
    --on-info: #102337;
    --carryover: #d5b3f3;
    --carryover-weak: #352944;
  }
}
