/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

.test-mode-banner {
  width: 100%;
  box-sizing: border-box;
  padding: 12rpx 20rpx;
  background: #fff3e0;
  color: #c65d00;
  border: 1rpx solid #ffd6a0;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.45;
  text-align: center;
  font-weight: 600;
}

/* 统一提高原生输入控件占位文字的对比度，避免浅灰文字在真机上难以辨认。 */
.form-placeholder {
  color: #9299a1;
  -webkit-text-fill-color: #9299a1;
  opacity: 1;
}
