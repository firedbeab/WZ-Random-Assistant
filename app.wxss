@import "styles/tokens.wxss";
@import "styles/themes.wxss";

page { background: var(--bg); color: var(--text-1); }
.appearance-toolbar { display: flex; align-items: center; justify-content: flex-end; padding: 0 var(--space-5); }

/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

.test-mode-banner {
  width: 100%;
  box-sizing: border-box;
  padding: 12rpx 20rpx;
  background: var(--warn-weak);
  color: var(--warn);
  border: 1rpx solid var(--warn-weak);
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.45;
  text-align: center;
  font-weight: 600;
}

/* 统一提高原生输入控件占位文字的对比度，避免浅灰文字在真机上难以辨认。 */
.form-placeholder {
  color: var(--placeholder);
  -webkit-text-fill-color: var(--placeholder);
  opacity: 1;
}
