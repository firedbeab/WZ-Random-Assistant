@import "../../styles/community.wxss";
.journal-page{position:relative;overflow:hidden;overflow-anchor:none}.journal-top{position:relative;flex:none}.journal-page .c-content{position:relative;z-index:1}.journal-top .info-head,.journal-cover{position:relative;z-index:1}
.journal-tabs{position:relative;display:flex;border-bottom:1rpx solid var(--line);margin-bottom:8rpx}.journal-tab{display:flex;align-items:center;justify-content:center;width:50%;margin:0;min-height:88rpx;padding:12rpx 4rpx;color:var(--text-2);background:transparent;border-radius:0;font-size:29rpx;transition:color 300ms}.journal-tab.active{color:var(--accent);font-weight:600}.journal-tab-indicator{position:absolute;left:0;bottom:0;width:50%;display:flex;justify-content:center;transition:transform 320ms ease}.journal-tab-indicator.on-likes{transform:translateX(100%)}.journal-tab-indicator>view{width:100rpx;height:4rpx;border-radius:4rpx;background:var(--accent)}
.month-bar{display:flex;align-items:center;justify-content:space-between;padding:16rpx 0}.month-title{font-size:34rpx;font-weight:600}.month-arrows{display:flex}.month-arrows .month-arrow{display:flex;align-items:center;justify-content:center;margin:0;width:76rpx;height:76rpx;padding:0;background:transparent}.month-arrow::after,.journal-tab::after{border:0}.month-arrow.month-disabled{opacity:.3}.month-arrow image{width:32rpx;height:32rpx;flex:none}.next-month{transform:rotate(180deg)}
.journal-panel{animation:journal-in 320ms ease both}.journal-paper{background:var(--surface);border-radius:var(--radius-lg);padding:0 28rpx;box-shadow:var(--shadow-sm)}.journal-day{display:flex;align-items:flex-start;gap:24rpx;padding:8rpx 0}.journal-day+.journal-day{border-top:1rpx solid var(--line)}.journal-date{width:56rpx;flex:none;text-align:center;padding-top:25rpx}.journal-day-number{display:block;font-size:44rpx;line-height:1.3;font-weight:500}.journal-day-body{flex:1;min-width:0}.journal-record{display:flex;width:100%;margin:0;padding:26rpx 0;background:transparent;text-align:left;border-radius:0;color:var(--text-1);line-height:1.5}.journal-record::after{border:0}.journal-record+.journal-record,.journal-extra .journal-record{border-top:1rpx solid var(--line)}.record-title{display:block;font-size:32rpx;font-weight:600;overflow-wrap:anywhere}.record-count{display:block;font-size:24rpx;color:var(--text-2);margin-top:14rpx}.record-footer{display:flex;align-items:center;gap:8rpx;margin-top:16rpx;color:var(--accent);font-size:22rpx}.record-arrow{width:26rpx;height:26rpx;margin-left:auto;flex:none}
.journal-extra{display:grid;grid-template-rows:0fr;opacity:0;visibility:hidden;transition:grid-template-rows 320ms ease,opacity 250ms ease,visibility 320ms}.journal-extra.expanded{grid-template-rows:1fr;opacity:1;visibility:visible}.journal-extra-inner{min-height:0;overflow:hidden}.journal-expand{display:flex;align-items:center;justify-content:center;gap:14rpx;width:100%;padding:12rpx 0;min-height:80rpx;background:transparent;color:var(--accent);font-size:24rpx}.journal-expand image{width:26rpx;height:26rpx;transition:transform 300ms}.journal-expand image.expanded{transform:rotate(180deg)}.journal-expand::after{border:0}.journal-foot{text-align:center;margin:32rpx 0}
.detail-song{font-size:42rpx;line-height:1.5;font-weight:600;display:block;overflow-wrap:anywhere}.detail-count{display:flex;align-items:baseline;gap:14rpx;margin:30rpx 0 12rpx;color:var(--text-2);font-size:26rpx}.detail-count>text:first-child{font-size:76rpx;font-weight:600;color:var(--accent);line-height:1.25}.detail-count-note{margin-bottom:28rpx}.detail-meta{display:flex;justify-content:space-between;gap:20rpx;border-top:1rpx dashed var(--line-strong);padding:22rpx 0;color:var(--text-2);font-size:24rpx}.detail-submission-status{margin:24rpx 0 28rpx}.detail-footer-actions{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-top:8rpx}.detail-unlike{display:flex;align-items:center;justify-content:center;min-height:80rpx;margin:0;padding:12rpx 0;background:transparent;color:var(--danger);font-size:24rpx}.detail-unlike::after{border:0}.detail-close{margin-left:auto;min-width:100rpx}.journal-refresh-error{padding:8rpx 0}.journal-refresh-error .c-link{justify-content:flex-start}
@keyframes journal-in{from{opacity:0}to{opacity:1}}
@media(prefers-reduced-motion:reduce){.journal-panel{animation:none}.journal-extra,.journal-expand image,.journal-tab-indicator,.journal-tab{transition:none}}
