@import "../../styles/community.wxss";
.journal-cover{margin-bottom:32rpx}.journal-cover .c-title{font-size:38rpx}.month-bar{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid var(--line);padding:16rpx 0}.month-title{font-size:36rpx;font-weight:600}.month-arrows{display:flex}.month-arrows button{display:flex;align-items:center;justify-content:center;margin:0;width:80rpx;height:80rpx;padding:0;background:transparent}.month-arrows button::after{border:0}.month-arrows image{width:32rpx;height:32rpx}.journal-paper{background:var(--surface);border-radius:var(--radius-lg);padding:0 28rpx;box-shadow:var(--shadow-sm)}.journal-record{display:flex;align-items:flex-start;gap:24rpx;width:100%;margin:0;padding:34rpx 0;background:transparent;text-align:left;border-radius:0;color:var(--text-1);line-height:1.5}.journal-record::after{border:0}.journal-record+.journal-record{border-top:1rpx solid var(--line)}.journal-date{width:56rpx;flex:none;text-align:center}.journal-date>text:first-child{display:block;font-size:46rpx;line-height:1.3;font-weight:500}.record-title{display:block;font-size:34rpx;font-weight:600;overflow-wrap:anywhere}.record-count{display:block;font-size:24rpx;color:var(--text-2);margin-top:18rpx}.record-footer{display:flex;align-items:center;gap:8rpx;margin-top:20rpx;color:var(--accent);font-size:22rpx}.record-footer image{width:26rpx;height:26rpx}.record-footer .record-arrow{margin-left:auto}.journal-foot{text-align:center;margin:32rpx 0}.detail-song{font-size:46rpx;line-height:1.5;font-weight:600;display:block;overflow-wrap:anywhere}.detail-count{display:flex;align-items:baseline;gap:14rpx;margin:32rpx 0 12rpx;color:var(--text-2);font-size:26rpx}.detail-count>text:first-child{font-size:80rpx;font-weight:600;color:var(--accent);line-height:1.25}.detail-meta{display:flex;justify-content:space-between;gap:20rpx;border-top:1rpx dashed var(--line-strong);padding:24rpx 0;color:var(--text-2);font-size:24rpx}.detail-meta:first-of-type{margin-top:32rpx}
