<page-meta page-style="{{appearanceStyle}} {{viewportStyle}} {{sheet || _adminDialogVisible ? 'overflow:hidden;' : 'overflow:auto;'}}" />
<view class="info-page community"><app-navigation back parent="/pages/my/index"/><view class="info-head"><view class="info-heading-row"><text class="info-title">我赞过的</text><appearance-toggle/></view></view>
 <view class="c-content" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel">
  <view class="journal-cover"><text class="c-title">原来，也有人和你一样。</text><text class="c-sub">喜欢的歌，替你留在这一页。</text></view>
  <view class="month-bar"><text class="month-title num">{{month}}</text><view class="month-arrows"><button bindtap="changeMonth" data-step="1" disabled="{{monthIndex === months.length - 1 || busy}}" aria-label="上一个月"><image src="{{themeIcons.back}}"/></button><button bindtap="changeMonth" data-step="-1" disabled="{{monthIndex === 0 || busy}}" aria-label="下一个月"><image src="{{themeIcons.chevronRight}}"/></button></view></view>
  <view class="c-state" wx:if="{{loading && !entries.length}}"><text class="c-title">正在找回那些喜欢</text><text class="c-sub">正在读取你的点赞记录。</text></view>
  <view class="c-state" wx:elif="{{error}}"><text class="c-title">暂时没能读取记录</text><text class="c-sub">{{error}}</text><button class="c-link" bindtap="retry">重新读取</button></view>
  <view class="c-state" wx:elif="{{!entries.length}}"><text class="c-title">这个月，还没有点赞记录</text><text class="c-sub">在歌单里给喜欢的歌曲点个赞，就会留在这里。</text><button class="c-link" bindtap="goCurrent">去看看歌单</button></view>
  <view class="journal-paper" wx:if="{{entries.length}}"><button class="journal-record" wx:for="{{entries}}" wx:key="id" bindtap="openRecord" data-id="{{item.id}}" data-schedule="{{item.scheduleId}}"><view class="journal-date"><text>{{item.day}}</text><text class="c-caption">{{item.month}}月</text></view><view class="c-grow"><text class="record-title">{{item.title}}</text><text class="c-sub">{{item.singer}}</text><text class="c-caption">{{item.period}}</text><text class="record-count">{{item.others ? '还有 ' + item.others + ' 人和你一样喜欢' : '这一份喜欢，来自你。'}}</text><view class="record-footer"><image src="{{themeIcons.heartFilled}}"/><text>{{item.interactive ? '已点赞' : '已截止 · 最终数量'}}</text><image class="record-arrow" src="{{themeIcons.chevronRight}}"/></view></view></button></view>
  <button class="c-link" wx:if="{{hasMore && !loading}}" bindtap="loadMore">查看更多</button><text class="c-caption journal-foot">记录随所属歌单保留六个月</text>
 </view>
</view>
<view class="admin-drawer-mask c-sheet {{sheetClosing ? 'drawer-closing' : ''}}" wx:if="{{sheet}}"><view class="drawer-backdrop" catchtap="closeSheet" catchtouchmove="adminDrawerNoop"/><view class="admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeSheet"><view class="drawer-handle" data-drawer-drag="true" catchtouchmove="adminDrawerNoop"/><view class="c-sheet-head"><text class="modal-title">这首歌，你也喜欢</text></view><scroll-view scroll-y class="c-sheet-scroll" show-scrollbar="{{false}}"><view class="c-sheet-body"><text class="detail-song">{{detail.title}}</text><text class="c-sub">{{detail.singer}}</text><view class="detail-count"><text>{{detail.count}}</text><text>人点赞 · {{detail.interactive ? '当前' : '最终'}}</text></view><text class="c-caption">{{detail.others ? '其中有你，也有 ' + detail.others + ' 位同样喜欢的人。' : '这一份喜欢，来自你。'}}</text><view class="detail-meta"><text>所属歌单</text><text>{{detail.period}}</text></view><view class="detail-meta"><text>点赞日期</text><text>{{detail.date}}</text></view><text class="c-error" wx:if="{{sheetError}}">{{sheetError}}</text></view></scroll-view><view class="c-sheet-actions"><button class="c-link" bindtap="goPlaylist">查看这期歌单</button><button class="c-secondary" wx:if="{{detail.interactive}}" bindtap="cancelLike" disabled="{{busy}}">{{busy ? '正在取消…' : '取消点赞'}}</button><button class="c-link" bindtap="closeSheet" disabled="{{busy}}">收好这张小票</button></view></view></view>
<privacy-popup id="privacyPopup"/><include src="../../templates/admin-feedback.wxml"/>
