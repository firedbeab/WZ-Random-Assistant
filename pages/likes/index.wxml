<page-meta page-style="{{appearanceStyle}} {{viewportStyle}} {{sheet || _adminDialogVisible ? 'overflow:hidden;' : 'overflow:auto;'}}" />
<template name="journal-row"><button class="journal-record" bindtap="openRecord" data-key="{{row.recordKey}}"><view class="c-grow"><text class="record-title">{{row.title}}</text><text class="c-sub">{{row.singer}}</text><text class="c-caption">{{row.period}}</text><text wx:if="{{row.kind === 'likes'}}" class="record-count">{{row.others ? '还有 ' + row.others + ' 人和你一样喜欢' : '这一份喜欢，来自你。'}}</text><view class="record-footer"><text class="record-status">{{row.kind === 'likes' ? (row.interactive ? '已喜欢' : '已截止') : row.statusLabel}}</text><image class="record-arrow" src="{{themeIcons.chevronRight}}" /></view></view></button></template>
<view class="info-page community journal-page"><app-navigation back parent="/pages/my/index"/><image class="journal-motif" src="{{tab === 'likes' ? themeIcons.heartFilledDecor : themeIcons.journalDecor}}" mode="aspectFit" aria-hidden="true"/><image class="journal-motif motif-edge" src="{{tab === 'likes' ? themeIcons.heartFilledDecor : themeIcons.journalDecor}}" mode="aspectFit" aria-hidden="true"/>
 <view class="journal-top"><view class="info-head compact-head"><view class="info-heading-row"><text class="info-title">点歌记录</text><appearance-toggle/></view></view></view>
 <view class="c-content" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel">
  <view class="journal-tabs" role="tablist"><button class="journal-tab {{tab === 'submissions' ? 'active' : ''}}" bindtap="switchTab" data-tab="submissions" role="tab" aria-selected="{{tab === 'submissions'}}">我点过的</button><button class="journal-tab {{tab === 'likes' ? 'active' : ''}}" bindtap="switchTab" data-tab="likes" role="tab" aria-selected="{{tab === 'likes'}}">我喜欢的</button><view class="journal-tab-indicator {{tab === 'likes' ? 'on-likes' : ''}}"><view/></view></view>
  <view class="month-bar"><text class="month-title num">{{month}}</text><view class="month-arrows"><button class="month-arrow {{monthIndex === months.length - 1 ? 'month-disabled' : ''}}" bindtap="changeMonth" data-step="1" aria-disabled="{{monthIndex === months.length - 1}}" aria-label="上一个月"><image src="{{themeIcons.back}}"/></button><button class="month-arrow {{monthIndex === 0 ? 'month-disabled' : ''}}" bindtap="changeMonth" data-step="-1" aria-disabled="{{monthIndex === 0}}" aria-label="下一个月"><image class="next-month" src="{{themeIcons.back}}"/></button></view></view>
  <view wx:for="{{panels}}" wx:key="*this" class="journal-panel">
   <view class="c-state" wx:if="{{loading && !entries.length}}"><text class="c-title">正在读取记录</text><text class="c-sub">请稍候。</text></view>
   <view class="c-state" wx:elif="{{error && !entries.length}}"><text class="c-title">暂时没能读取记录</text><text class="c-sub">{{error}}</text><button class="c-link" bindtap="retry">重新读取</button></view>
   <view class="c-state" wx:elif="{{!entries.length}}"><text class="c-title">{{tab === 'likes' ? '这个月，还没有喜欢的歌曲' : '这个月，还没有点歌记录'}}</text><text class="c-sub">{{tab === 'likes' ? '在歌单里点亮爱心，喜欢就会留在这里。' : '这里展示仍在保留范围内的投稿，已清理的旧记录无法恢复。'}}</text><button class="c-link" bindtap="goCurrent">去看看歌单</button></view>
   <view class="journal-paper" wx:if="{{entries.length}}"><view class="journal-day" wx:for="{{groups}}" wx:key="key" wx:for-item="group"><view class="journal-date"><text class="journal-day-number">{{group.day}}</text><text class="c-caption">{{group.month}}月</text></view><view class="journal-day-body"><template is="journal-row" wx:for="{{group.first}}" wx:key="recordKey" wx:for-item="row" data="{{row,themeIcons}}"/><view class="journal-extra {{group.expanded ? 'expanded' : ''}}" aria-hidden="{{!group.expanded}}"><view class="journal-extra-inner"><template is="journal-row" wx:for="{{group.rest}}" wx:key="recordKey" wx:for-item="row" data="{{row,themeIcons}}"/></view></view><button wx:if="{{group.rest.length}}" class="journal-expand" bindtap="toggleGroup" data-date="{{group.key}}" aria-expanded="{{group.expanded}}"><text>{{group.expanded ? '收起' : '展开其余 ' + group.rest.length + ' 首'}}</text><image class="{{group.expanded ? 'expanded' : ''}}" src="{{themeIcons.chevron}}"/></button></view></view></view>
   <view wx:if="{{error && entries.length}}" class="journal-refresh-error"><text class="c-error">{{error}}</text><button class="c-link" bindtap="retry">重试</button></view><button class="c-link" wx:if="{{hasMore && !loading}}" bindtap="loadMore">继续加载本月记录</button>
  </view><text class="c-caption journal-foot">记录按所属期次保留六个月</text>
 </view>
</view>
<view class="admin-drawer-mask c-sheet {{sheetClosing ? 'drawer-closing' : ''}}" wx:if="{{sheet}}"><view class="drawer-backdrop" catchtap="closeSheet" catchtouchmove="adminDrawerNoop"/><view class="admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeSheet"><view class="drawer-handle" data-drawer-drag="true" catchtouchmove="adminDrawerNoop"/><view class="c-sheet-head"><text class="modal-title">{{detail.kind === 'likes' ? '歌曲详情' : '点歌详情'}}</text></view><scroll-view scroll-y class="c-sheet-scroll" show-scrollbar="{{false}}"><view class="c-sheet-body"><text class="detail-song">{{detail.title}}</text><text class="c-sub">{{detail.singer}}</text><block wx:if="{{detail.kind === 'likes'}}"><view class="detail-count"><text>{{detail.count}}</text><text>人点赞{{detail.interactive ? '' : ' · 最终'}}</text></view><text class="c-caption detail-count-note">{{detail.others ? '其中有你，也有 ' + detail.others + ' 位同样喜欢的人。' : '这一份喜欢，来自你。'}}</text></block><view wx:else class="detail-submission-status"><text class="c-badge">{{detail.statusLabel}}</text><text class="c-sub" wx:if="{{detail.placement}}">安排在 {{detail.placement.weekKey}} 期 · {{['','周一','周二','周三','周四','周五'][detail.placement.day]}}</text><view wx:if="{{detail.note}}" class="c-reply"><text class="c-caption">你的备注</text><text class="c-text">{{detail.note}}</text></view></view><view class="detail-meta"><text>所属期次</text><text>{{detail.period}}</text></view><view class="detail-meta"><text>{{detail.kind === 'likes' ? '喜欢日期' : '投稿日期'}}</text><text>{{detail.date}}</text></view><text class="c-error" wx:if="{{sheetError}}">{{sheetError}}</text></view></scroll-view><view class="c-sheet-actions"><button class="c-secondary" wx:if="{{detail.kind === 'likes' || detail.placement}}" bindtap="goPlaylist" disabled="{{busy}}">查看这期歌单</button><view class="detail-footer-actions"><button class="detail-unlike" wx:if="{{detail.kind === 'likes' && detail.interactive}}" bindtap="cancelLike" disabled="{{busy}}">{{busy ? '请稍候…' : '取消喜欢'}}</button><button class="c-link detail-close" bindtap="closeSheet" disabled="{{busy}}">关闭</button></view></view></view></view>
<privacy-popup id="privacyPopup"/><include src="../../templates/admin-feedback.wxml"/>
