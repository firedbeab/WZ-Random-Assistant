@import "../help/index.wxss";
.log-new{min-height:80rpx;padding:12rpx 0 12rpx 20rpx;color:var(--accent);font-size:26rpx}.log-timeline{padding:0 0 0 26rpx;margin-left:8rpx;border-left:2rpx solid var(--line-strong)}.log-entry{position:relative;padding:0 28rpx;margin-bottom:28rpx}.log-entry+.log-entry{border-top:0}.log-entry::before{content:"";position:absolute;top:40rpx;left:-36rpx;width:16rpx;height:16rpx;border-radius:50%;background:var(--accent);border:4rpx solid var(--bg)}.log-version-row{display:flex;align-items:baseline;justify-content:space-between;gap:20rpx;margin-bottom:14rpx}.log-version{color:var(--accent);font-size:36rpx;font-weight:650}.log-date{color:var(--text-3);font-size:23rpx}.log-entry .article-header{padding-bottom:22rpx}.log-edit{color:var(--accent);font-size:24rpx;min-height:72rpx;margin:0 0 8rpx auto;display:flex;align-items:center}.log-drafts{margin-bottom:28rpx;padding:24rpx;background:var(--surface-2);border-radius:var(--radius-md)}.log-drafts-title{color:var(--text-2);font-size:26rpx}.log-draft{display:flex;align-items:center;justify-content:space-between;width:100%;padding:20rpx 0;color:var(--text-2);font-size:25rpx;line-height:1.6}.log-draft+.log-draft{border-top:1rpx solid var(--line)}
