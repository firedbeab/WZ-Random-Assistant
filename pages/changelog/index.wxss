@import "../help/index.wxss";
.log-new{min-height:80rpx;padding:12rpx 0 12rpx 20rpx;color:var(--accent);font-size:26rpx}.log-timeline{padding:0 0 0 26rpx;margin-left:8rpx;border-left:2rpx solid var(--line-strong)}.log-entry{position:relative;padding:0 var(--space-4);margin-bottom:var(--space-4)}.log-entry+.log-entry{border-top:0}.log-entry::before{content:"";position:absolute;top:34rpx;left:-36rpx;width:16rpx;height:16rpx;border-radius:50%;background:var(--accent);border:4rpx solid var(--bg)}.log-version-row{display:flex;flex-wrap:wrap;align-items:baseline;gap:4rpx var(--space-3)}.log-entry.can-edit .log-version-row{padding-right:64rpx}.log-version{color:var(--accent);font-size:var(--font-lg);font-weight:600;line-height:1.5;overflow-wrap:anywhere}.log-date{color:var(--text-3);font-size:var(--font-sm);line-height:1.5;white-space:nowrap}.log-entry .article-header{min-height:0;padding:var(--space-4) 0;gap:var(--space-3)}.log-entry .article-title{margin-top:var(--space-1);font-size:var(--font-lg);line-height:1.5}.log-entry .article-summary{margin-top:4rpx;font-size:var(--font-sm);line-height:1.65}.log-entry .article-body{padding-bottom:var(--space-4)}.log-edit{position:absolute;top:12rpx;right:var(--space-3);display:flex;align-items:center;justify-content:center;min-width:72rpx;min-height:64rpx;padding:8rpx;color:var(--accent);font-size:var(--font-sm);line-height:1.5;border-radius:var(--radius-sm);box-sizing:border-box}.log-drafts{margin-bottom:28rpx;padding:24rpx;background:var(--surface-2);border-radius:var(--radius-md)}.log-drafts-title{color:var(--text-2);font-size:26rpx}.log-draft{display:flex;align-items:center;justify-content:space-between;width:100%;padding:20rpx 0;color:var(--text-2);font-size:25rpx;line-height:1.6}.log-draft+.log-draft{border-top:1rpx solid var(--line)}
