<page-meta page-style="{{appearanceStyle}} {{viewportStyle}}" />
<view class="info-page ornament-page">
  <app-navigation back parent="/pages/about/index" />
  <image class="page-ornament" src="{{themeIcons.changelogDecor}}" mode="aspectFit" aria-hidden="true"/><image class="page-ornament motif-edge" src="{{themeIcons.changelogDecor}}" mode="aspectFit" aria-hidden="true"/><view class="info-head ornament-head">
    <view class="info-heading-row"><text class="info-title">更新日志</text><button wx:if="{{canEdit}}" class="info-button log-new" bindtap="newLog">＋ 新建</button></view>
    <text class="info-desc">按版本查看新增功能与改进。</text>
  </view>

  <view class="info-content"><view class="log-drafts" wx:if="{{canEdit && drafts.length}}"><text class="log-drafts-title">待发布 · {{drafts.length}}</text><button class="info-button log-draft" wx:for="{{drafts}}" wx:key="_id" bindtap="editLog" data-id="{{item._id}}"><text>{{item.version}} · {{item.title}}</text><text>编辑 ›</text></button></view>
    <view class="info-state" wx:if="{{loading && articles.length === 0}}">
      <text class="info-state-title">正在加载更新日志…</text>
      <text class="info-state-desc">正在获取内容，请稍候。</text>
    </view>

    <view class="info-state" wx:elif="{{loadFailed}}">
      <text class="info-state-title">{{loadErrorTitle}}</text>
      <text class="info-state-desc">{{loadErrorText}}</text>
      <button class="info-button retry-btn" hover-class="info-pressed" bindtap="retryLoad">重新加载 ›</button>
    </view>

    <view class="info-state" wx:elif="{{articles.length === 0}}">
      <text class="info-state-title">还没有已发布的更新日志</text>
      <text class="info-state-desc">内容发布后会在这里显示。</text>
    </view>

    <view class="article-list log-timeline" wx:else>
      <view class="article-card log-entry info-surface {{expandedId === item._id ? 'expanded' : ''}}" wx:for="{{articles}}" wx:key="_id">
        <button class="article-header info-button" hover-class="info-pressed" bindtap="toggleArticle" data-id="{{item._id}}" aria-expanded="{{expandedId === item._id}}">
          <view class="article-heading">
            <view class="log-version-row"><text class="log-version">{{item.version}}</text><text class="log-date">{{item.release_date}}</text></view><text class="article-title">{{item.title}}</text>
            <text class="article-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
          </view>
          <image class="info-chevron article-arrow" src="{{themeIcons.chevron}}" mode="aspectFit" aria-hidden="true" />
        </button>

        <button class="info-button log-edit" wx:if="{{canEdit}}" bindtap="editLog" data-id="{{item._id}}">编辑此条</button>
        <view class="article-body-wrap {{expandedId === item._id ? 'is-open' : ''}}" aria-hidden="{{expandedId !== item._id}}">
        <view class="article-body-clip">
        <view class="article-body" wx:if="{{item._opened}}">
          <text class="article-content" user-select>{{item.content}}</text>
          <view class="image-grid" wx:if="{{item.images.length > 0}}">
            <block
              wx:for="{{item.images}}"
              wx:for-item="imageUrl"
              wx:for-index="imageIndex"
              wx:key="*this"
            >
            <view wx:if="{{imageIndex < 4}}" class="help-image-wrap {{item.images.length === 1 ? 'single' : ''}}">
              <image
                class="help-image"
                src="{{imageSrcs[imageUrl] || ''}}"
                mode="aspectFill"
                lazy-load
                bindtap="previewImage"
                binderror="onImageError"
                data-current="{{imageUrl}}"
                data-images="{{item.images}}"
                data-file-id="{{imageUrl}}"
              ></image>
              <view
                class="image-more"
                wx:if="{{imageIndex === 3 && item.images.length > 4 && !imageErrors[imageUrl]}}"
                bindtap="previewImage"
                data-current="{{imageUrl}}"
                data-images="{{item.images}}"
                role="button"
                aria-label="还有{{item.images.length - 4}}张，点开后可滑动查看全部图片"
              >还有 {{item.images.length - 4}} 张</view>
              <view
                class="image-failed"
                wx:if="{{imageErrors[imageUrl]}}"
                catchtap="retryImages"
                data-images="{{item.images}}"
                data-file-id="{{imageUrl}}"
              >图片加载失败，点此重试</view>
            </view>
            </block>
          </view>
          <text class="image-hint" wx:if="{{item.images.length > 0}}">{{item.images.length > 4 ? '共 ' + item.images.length + ' 张，点开后可左右滑动查看全部图片' : '点击图片可全屏查看'}}</text>
        </view>
        </view>
        </view>
      </view>
    </view>
  </view>
</view>
<include src="../../templates/feedback.wxml" />
