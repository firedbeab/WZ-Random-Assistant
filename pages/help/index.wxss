@import "../../styles/info-pages.wxss";

.article-list { padding: 0 var(--space-5); }
.article-card + .article-card { border-top: 1rpx solid var(--line); }
.article-header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); width: 100%; min-height: 128rpx; padding: 34rpx 0; box-sizing: border-box; }
.article-heading { flex: 1; min-width: 0; }
.article-title { display: block; font-size: 30rpx; font-weight: 600; line-height: 1.6; overflow-wrap: break-word; word-break: break-all; }
.article-summary { display: block; margin-top: 10rpx; color: var(--text-2); font-size: var(--font-sm); line-height: 1.75; overflow-wrap: break-word; word-break: break-all; }
.expanded .article-arrow { transform: rotate(180deg); }
.article-arrow { transition: transform 240ms ease; }
.article-body-wrap { display: grid; grid-template-rows: 0fr; opacity: 0; pointer-events: none; transition: grid-template-rows 320ms ease, opacity 240ms ease; }
.article-body-wrap.is-open { grid-template-rows: 1fr; opacity: 1; pointer-events: auto; }
.article-body-clip { min-height: 0; overflow: hidden; }
.article-body { padding-bottom: 40rpx; }
.article-body::before { content: ''; display: block; width: 80rpx; height: 3rpx; margin-bottom: var(--space-4); border-radius: var(--radius-pill); background: var(--line-strong); }
.article-content { display: block; color: var(--text-2); font-size: var(--font-md); line-height: 1.9; white-space: pre-wrap; overflow-wrap: break-word; word-break: break-all; }
.image-grid { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
.help-image-wrap { position: relative; width: calc(50% - 8rpx); height: 220rpx; border-radius: var(--radius-md); overflow: hidden; background: var(--surface-2); }
.help-image-wrap.single { width: 100%; height: 340rpx; }
.help-image { width: 100%; height: 100%; background: var(--surface-2); }
.image-more { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, .5); color: var(--on-overlay); font-size: var(--font-md); font-weight: 600; }
.image-failed { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 0 var(--space-3); background: rgba(0, 0, 0, .55); color: var(--on-overlay); font-size: 22rpx; line-height: 1.6; text-align: center; }
.image-hint { display: block; margin-top: 20rpx; color: var(--text-3); font-size: 22rpx; line-height: 1.8; text-align: center; }
.retry-btn { min-height: 88rpx; margin-top: var(--space-4); padding: 20rpx 0; color: var(--accent); font-size: 26rpx; line-height: 1.8; }
