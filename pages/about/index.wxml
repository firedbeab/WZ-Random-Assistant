<page-meta page-style="{{appearanceStyle}}" />
<view class="info-page">
  <app-navigation back />
  <view class="info-head">
    <view class="info-heading-row"><text class="info-title">关于</text><appearance-toggle /></view>
    <text class="info-desc">了解工具，找到帮助和反馈。</text>
  </view>

  <view class="info-content">
    <view class="info-surface intro-card">
      <text class="intro-title">WZ随机助手</text>
      <text class="intro-content">用于校园广播站每周点歌、随机抽取与排期发布。提交通道通常在每周日 8:00–20:00 开放。</text>
      <text class="version-label">版本 v1.9</text>
    </view>

    <view class="info-surface entry-list">
      <button class="info-button info-entry" hover-class="info-pressed" bindtap="goHelp">
        <view class="entry-text">
          <text class="entry-label">使用说明</text>
          <text class="entry-caption">点歌规则、歌单查看与常见问题</text>
        </view>
        <image class="info-chevron entry-arrow" src="{{themeIcons.chevron}}" mode="aspectFit" aria-hidden="true" />
      </button>
      <button class="info-button info-entry" hover-class="info-pressed" bindtap="goFeedback">
        <view class="entry-text">
          <text class="entry-label">意见反馈</text>
          <text class="entry-caption">复制问卷链接，在浏览器中填写</text>
        </view>
        <image class="info-chevron entry-arrow" src="{{themeIcons.chevron}}" mode="aspectFit" aria-hidden="true" />
      </button>
      <button class="info-button info-entry" hover-class="info-pressed" bindtap="goAdminLogin">
        <view class="entry-text">
          <text class="entry-label">管理员验证</text>
          <text class="entry-caption">管理人员使用</text>
        </view>
        <image class="info-chevron entry-arrow" src="{{themeIcons.chevron}}" mode="aspectFit" aria-hidden="true" />
      </button>
    </view>
  </view>

  <view class="info-footer">
    <button class="info-button privacy-link" hover-class="info-pressed" bindtap="openPrivacy">隐私保护指引</button>
    <text class="attribution">WZ随机助手 | @发牌的小度</text>
  </view>
</view>

<privacy-popup id="privacyPopup"></privacy-popup>
<include src="../../templates/feedback.wxml" />
