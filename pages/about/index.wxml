<page-meta page-style="{{appearanceStyle}} {{viewportStyle}}" />
<view class="info-page ornament-page">
  <app-navigation back parent="/pages/my/index" />
  <image class="page-ornament" src="{{themeIcons.aboutDecor}}" mode="aspectFit" aria-hidden="true" /><image class="page-ornament motif-edge" src="{{themeIcons.aboutDecor}}" mode="aspectFit" aria-hidden="true" /><view class="info-head ornament-head">
    <view class="info-heading-row"><text class="info-title">关于</text></view>
    <text class="info-desc">了解工具，查看说明与管理入口。</text>
  </view>

  <view class="info-content">
    <view class="info-surface intro-card">
      <text class="intro-title">WZ随机助手</text>
      <text class="intro-content">用于校园广播站每周点歌、随机抽取与排期发布。提交通道通常在每周五 20:00 至周日 20:00 开放。</text>
      <text class="version-label">版本 v{{appVersion}}</text>
    </view>

    <view class="info-surface entry-list profile-entries">
      <button class="info-button info-entry profile-entry" hover-class="info-pressed" bindtap="goFeedback"><view class="info-entry-icon profile-entry-icon"><image src="{{themeIcons.feedback}}" mode="aspectFit" /></view><view class="entry-text"><text class="entry-label profile-entry-title">反馈中心</text><text class="entry-caption profile-entry-caption">使用反馈与功能投票</text></view><image class="info-chevron entry-arrow profile-entry-arrow" src="{{themeIcons.chevron}}" mode="aspectFit" aria-hidden="true" /></button>
      <button class="info-button info-entry profile-entry" hover-class="info-pressed" bindtap="goHelp">
        <view class="info-entry-icon profile-entry-icon"><image src="{{themeIcons.help}}" mode="aspectFit" /></view><view class="entry-text">
          <text class="entry-label profile-entry-title">使用说明</text>
          <text class="entry-caption profile-entry-caption">点歌规则、歌单查看与常见问题</text>
        </view>
        <image class="info-chevron entry-arrow profile-entry-arrow" src="{{themeIcons.chevron}}" mode="aspectFit" aria-hidden="true" />
      </button>
      <button class="info-button info-entry profile-entry" hover-class="info-pressed" bindtap="goChangelog"><view class="info-entry-icon profile-entry-icon"><image src="{{themeIcons.changelog}}" mode="aspectFit" /></view><view class="entry-text"><text class="entry-label profile-entry-title">更新日志</text><text class="entry-caption profile-entry-caption">查看版本变化与改进</text></view><image class="info-chevron entry-arrow profile-entry-arrow" src="{{themeIcons.chevron}}" mode="aspectFit" aria-hidden="true" /></button>
      <button class="info-button info-entry profile-entry" hover-class="info-pressed" bindtap="goAdminLogin">
        <view class="info-entry-icon profile-entry-icon"><image src="{{themeIcons.admin}}" mode="aspectFit" /></view><view class="entry-text">
          <text class="entry-label profile-entry-title">管理员验证</text>
          <text class="entry-caption profile-entry-caption">管理人员使用</text>
        </view>
        <image class="info-chevron entry-arrow profile-entry-arrow" src="{{themeIcons.chevron}}" mode="aspectFit" aria-hidden="true" />
      </button>
    </view>
  </view>

  <view class="info-footer">
    <button class="info-button privacy-link" hover-class="info-pressed" bindtap="openPrivacy">隐私保护指引</button>
    <text class="attribution">WZ随机助手 | @发牌的小度</text>
  </view>
</view>

<privacy-popup id="privacyPopup"></privacy-popup>
<include src="../../templates/feedback.wxml" />
