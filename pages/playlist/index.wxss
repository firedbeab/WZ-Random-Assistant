/* 已确认的 F.2：工具信息在卡片外，连续渐变贯穿导航和正文。 */
.playlist-page { display: flex; flex-direction: column; min-height: 100vh; box-sizing: border-box; padding-bottom: calc(44rpx + env(safe-area-inset-bottom)); background: var(--gradient-closed); color: var(--text-1); font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif; }
.playlist-content { flex: 1; }
.week-panel { animation: week-fade-in 320ms ease-out; }
@keyframes week-fade-in { from { opacity: .65; } to { opacity: 1; } }
.num { font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1; }
.notify-action, .tab-item, .retry { margin: 0; padding: 0; border: none; border-radius: 0; font-weight: 400; line-height: 1.5; }
.notify-action::after, .tab-item::after, .retry::after { border: none; }
.text-pressed { opacity: .6; }
.test-mode-banner { border: none; border-radius: 0; font-size: var(--font-xs); font-weight: 400; }
.playlist-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: 36rpx var(--space-5) 0; }
.page-title { font-size: var(--font-2xl); font-weight: 600; line-height: 1.4; }
.notify-action, .notify-status { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; min-height: 88rpx; padding-left: var(--space-3); background: transparent; color: var(--accent); font-size: var(--font-sm); white-space: nowrap; }
.notify-status { color: var(--text-2); }
.notify-action.is-disabled { color: var(--text-2) !important; background: transparent !important; }
.notify-icon { flex: none; width: 28rpx; height: 28rpx; }
.playlist-tools { padding: 0 var(--space-5) 40rpx; }
.week-tabs { display: flex; justify-content: flex-start; gap: var(--space-6); margin-top: 26rpx; }
.tab-item { position: relative; min-height: 88rpx; padding: 26rpx 0 28rpx; background: transparent; color: var(--text-2); font-size: var(--font-md); white-space: nowrap; }
.tab-item.active { color: var(--accent); font-weight: 600; }
.tab-item.active::after { position: absolute; content: ''; top: auto; height: 4rpx; width: auto; left: 0; right: 0; bottom: 8rpx; transform: none; border-radius: 4rpx; background: var(--accent); }
.period-meta { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); margin-top: var(--space-5); }
.period-range { color: var(--text-1); font-size: var(--font-lg); font-weight: 600; line-height: 1.5; }
.period-count { flex: none; color: var(--text-2); font-size: var(--font-sm); }
.copy-tip { display: block; margin-top: 20rpx; color: var(--text-3); font-size: 22rpx; line-height: 1.6; }
.schedule-card { margin: 0 var(--space-5); padding: 0 var(--space-5) var(--space-6); background: var(--surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
.day-section { padding-top: var(--space-6); }
.day-header { display: flex; align-items: center; gap: 20rpx; margin-bottom: var(--space-3); }
.day-title { font-size: 26rpx; font-weight: 600; color: var(--text-2); }
.day-date { font-size: var(--font-sm); color: var(--text-3); }
.day-line { height: 1rpx; flex: 1; margin-left: 8rpx; background: var(--line); }
.song-item { display: flex; align-items: flex-start; gap: 20rpx; margin: 0 calc(-1 * var(--space-2)); padding: var(--space-4) var(--space-2); border-radius: var(--radius-md); }
.song-pressed { background: var(--surface-2); }
.song-number { display: flex; align-items: center; justify-content: center; flex: none; width: 48rpx; height: 48rpx; margin-top: 2rpx; border-radius: var(--radius-pill); background: var(--accent-weak); color: var(--accent); font-size: var(--font-sm); }
.song-info { flex: 1; min-width: 0; }
.song-name { display: block; font-size: var(--font-song); font-weight: 600; line-height: 1.5; overflow-wrap: break-word; word-break: break-all; }
.song-singer { display: block; margin-top: var(--space-1); color: var(--text-2); font-size: 26rpx; line-height: 1.5; overflow-wrap: break-word; word-break: break-all; }
.song-special { display: flex; align-items: baseline; gap: var(--space-3); margin-top: 18rpx; padding-left: 18rpx; border-left: 4rpx solid var(--accent-weak); color: var(--text-2); font-size: var(--font-sm); line-height: 1.8; }
.special-label { flex: none; color: var(--text-3); font-size: 22rpx; }
.special-content { min-width: 0; white-space: pre-wrap; overflow-wrap: break-word; word-break: break-all; }
.no-song { display: block; padding: 20rpx 0 16rpx 68rpx; color: var(--text-3); font-size: 26rpx; line-height: 1.7; }
.note { margin-top: 56rpx; padding-top: 40rpx; border-top: 1rpx solid var(--line); }
.note-label { display: block; color: var(--text-2); font-size: 26rpx; font-weight: 600; }
.note-content { display: block; margin-top: var(--space-3); color: var(--text-2); font-size: var(--font-sm); line-height: 1.85; white-space: pre-wrap; overflow-wrap: break-word; word-break: break-all; }
.cache-hint { display: block; padding-top: 40rpx; font-size: var(--font-sm); line-height: 1.7; color: var(--text-3); }
.state { margin: 0 var(--space-5); padding: 64rpx 0 96rpx; }
.state-title { display: block; font-size: var(--font-xl); font-weight: 600; line-height: 1.5; }
.state-description { display: block; margin-top: var(--space-3); font-size: var(--font-md); line-height: 1.8; color: var(--text-2); }
.retry { margin-top: var(--space-4); min-height: 88rpx; padding: 20rpx 0; color: var(--accent); background: transparent; font-size: 26rpx; text-align: left; }
