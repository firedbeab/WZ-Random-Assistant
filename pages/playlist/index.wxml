<view class="playlist-page">
  <app-navigation back="{{true}}" />
  <view class="test-mode-banner" wx:if="{{isTestMode}}">测试模式 · 当前显示测试排期</view>
  <view class="playlist-head">
    <text class="page-title">每周歌单</text>
    <view wx:if="{{subscribed}}" class="notify-status" aria-label="本周发布提醒已开启">
      <image class="notify-icon" src="/assets/icons/bell-muted.svg" mode="aspectFit" aria-hidden="true" />
      <text>本周已开启</text>
    </view>
    <button wx:else class="notify-action {{subscribing ? 'is-disabled' : ''}}" bindtap="onEnableSub" disabled="{{subscribing}}" hover-class="text-pressed" aria-label="开启本周发布提醒">
      <image class="notify-icon" src="{{subscribing ? '/assets/icons/bell-muted.svg' : '/assets/icons/bell.svg'}}" mode="aspectFit" aria-hidden="true" />
      <text>{{subscribing ? '开启中…' : '发布提醒'}}</text>
    </button>
  </view>
  <view class="playlist-tools">
    <view class="week-tabs" role="tablist" aria-label="选择歌单期次">
      <button wx:for="{{tabs}}" wx:key="value" class="tab-item {{activeTab === item.value ? 'active' : ''}}" bindtap="switchWeek" data-value="{{item.value}}" role="tab" aria-selected="{{activeTab === item.value}}" hover-class="text-pressed">{{item.label}}</button>
    </view>
    <view class="period-meta">
      <text class="period-range num">{{periodRange}}</text>
      <text class="period-count num" wx:if="{{schedule && !loading}}">共 {{playlistTotal}} 首</text>
    </view>
    <text class="copy-tip" wx:if="{{schedule && !loading && playlistTotal > 0}}">长按曲目，复制完整信息</text>
  </view>
  <view class="state" wx:if="{{loading}}">
    <text class="state-title">正在加载歌单…</text>
    <text class="state-description">正在获取该期安排，请稍候。</text>
  </view>
  <view class="state" wx:elif="{{!schedule && loadError}}">
    <text class="state-title">歌单暂时未能加载</text>
    <text class="state-description">检查网络后重试，或先查看其他期次。</text>
    <button class="retry" bindtap="retryLoad" hover-class="text-pressed">重新加载 ›</button>
  </view>
  <view class="state" wx:elif="{{!schedule}}">
    <text class="state-title">{{activeTab === 0 ? '本期歌单尚未发布' : '该期歌单尚未发布'}}</text>
    <text class="state-description">可以先切换期次，查看往期歌单。</text>
  </view>
  <view class="schedule-card" wx:else>
      <text class="cache-hint" wx:if="{{showingCached}}">当前显示上次保存的内容，请联网后刷新核对。</text>
      <view class="day-section" wx:for="{{playlistDays}}" wx:key="key" wx:for-item="day">
        <view class="day-header">
          <text class="day-title">{{day.label}}</text>
          <text class="day-date num">{{day.dateText}}</text>
          <view class="day-line"></view>
        </view>
        <view class="song-item" wx:for="{{day.songs}}" wx:key="key" wx:for-item="song" bindlongpress="copyItem" data-name="{{song.title}}" data-singer="{{song.singer}}" data-note="{{song.note}}">
          <text class="song-number num">{{song.number}}</text>
          <view class="song-info">
            <text class="song-name">{{song.title}}</text>
            <text class="song-singer">{{song.singer}}</text>
            <view class="song-special" wx:if="{{song.note}}">
              <text class="special-label">备注</text>
              <text class="special-content">{{song.note}}</text>
            </view>
          </view>
        </view>
        <text class="no-song" wx:if="{{day.songs.length === 0}}">当天暂无安排</text>
      </view>
      <view class="note" wx:if="{{playlistNote}}">
        <text class="note-label">广播站说明</text>
        <text class="note-content">{{playlistNote}}</text>
      </view>
  </view>
</view>

<!-- 隐私协议弹窗 -->
<privacy-popup id="privacyPopup"></privacy-popup>
