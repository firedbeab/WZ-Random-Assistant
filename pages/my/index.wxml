<page-meta page-style="{{appearanceStyle}} {{sheet || _adminDialogVisible ? 'overflow:hidden;' : 'overflow:auto;'}}" />
<view class="info-page community">
  <app-navigation back />
  <view class="test-mode-banner" wx:if="{{isTestMode}}">测试模式 · 反馈与投票不会写入正式数据</view>
  <view class="info-head"><view class="info-heading-row"><text class="info-title">我的</text><appearance-toggle /></view><text class="info-desc">这一周的点歌，还有你的偏好。</text></view>
  <view class="c-content">
    <view class="my-profile c-row"><view class="my-avatar">WZ</view><view class="c-grow"><text class="my-alias">{{alias}}</text><text class="c-caption">{{profileReady ? '称呼仅用于显示，不影响账号身份' : error ? '账号读取失败，请重新加载' : '正在准备账号资料'}}</text></view><button class="c-link" bindtap="editAlias" disabled="{{!profileReady}}">修改</button></view>
    <view class="c-state" wx:if="{{error}}"><text class="c-title">暂时无法读取</text><text class="c-sub">{{error}}</text><button class="c-link" bindtap="load">重新加载</button></view>
    <view class="c-card" wx:elif="{{!loading}}"><text class="c-caption">本周点歌 · {{weekLabel}}</text><text class="c-title my-week-title">{{submission ? '你的点歌，已收到' : '这周，想听什么？'}}</text><text class="c-sub">{{submission ? '提交记录可在这里查看，最终安排以已发布歌单为准。' : '还没有本周提交记录，开放时可以回首页点歌。'}}</text><button class="c-link my-week-link" bindtap="openSubmission">{{submission ? '查看提交记录' : '回首页看看'}}<image src="{{themeIcons.chevronRight}}" /></button></view>
    <view class="c-state" wx:else><text class="c-title">正在读取本周记录</text><text class="c-sub">请稍候。</text></view>
    <view class="c-card my-entries"><button class="c-entry" bindtap="openAppearance"><view class="c-grow"><text class="c-title">外观设置</text><text class="c-sub">浅深模式、主题配色与自定义颜色</text></view><image src="{{themeIcons.chevronRight}}" /></button><button class="c-entry" bindtap="goFeedback"><view class="c-grow"><text class="c-title">反馈中心</text><text class="c-sub">说说使用感受，参与功能投票</text></view><image src="{{themeIcons.chevronRight}}" /></button><button class="c-entry" bindtap="goAbout"><view class="c-grow"><text class="c-title">关于</text><text class="c-sub">使用说明、版本与管理员验证</text></view><image src="{{themeIcons.chevronRight}}" /></button></view>
    <text class="c-caption my-foot">WZ随机助手 · v1.9</text>
  </view>
</view>
<view wx:if="{{sheet}}" class="admin-drawer-mask c-sheet {{sheet === 'alias' ? 'compact' : ''}} {{sheetClosing ? 'drawer-closing' : ''}}"><view class="drawer-backdrop" catchtap="closeSheet" catchtouchmove="adminDrawerNoop" /><view class="admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeSheet"><view class="drawer-handle" data-drawer-drag="true" catchtouchmove="adminDrawerNoop" /><view class="c-sheet-head"><text class="modal-title">{{sheet === 'alias' ? '怎么称呼你？' : sheet === 'appearance' ? '外观设置' : '本周提交记录'}}</text><text class="c-caption" wx:if="{{sheet === 'alias'}}">2–12 个字，无需填写真实姓名。</text></view>
  <scroll-view scroll-y class="c-sheet-scroll"><view class="c-sheet-body">
    <input wx:if="{{sheet === 'alias'}}" class="c-field my-alias-field" maxlength="12" value="{{aliasDraft}}" bindinput="inputAlias" placeholder="填写你的称呼" placeholder-class="c-placeholder" />
    <block wx:elif="{{sheet === 'appearance'}}"><text class="c-label">显示模式</text><view class="c-chips"><button wx:for="{{modes}}" wx:key="id" class="c-chip {{selectedMode === item.id ? 'active' : ''}}" bindtap="selectMode" data-id="{{item.id}}">{{item.label}}</button></view><text class="c-label">主题颜色</text><view class="my-palettes"><button wx:for="{{palettes}}" wx:key="id" class="my-palette {{selectedPalette === item.id ? 'selected' : ''}}" bindtap="selectPalette" data-id="{{item.id}}"><view class="my-swatch" style="background:{{item.color}};" /><text>{{item.label}}</text></button></view><button class="c-entry" bindtap="openColor"><view class="c-grow"><text class="c-title">自定义颜色</text><text class="c-sub">{{selectedPalette === 'custom' ? customColor : '从色盘挑选你喜欢的颜色'}}</text></view><image src="{{themeIcons.chevron}}" /></button><color-picker wx:if="{{colorEditing}}" value="{{customColor}}" bindchange="changeColor" /><text class="c-sub">系统会自动调整浅深模式下的强调色，保持文字可读。状态提示颜色保持固定，保存后应用到所有页面。</text></block>
    <block wx:else><text class="c-caption">{{weekLabel}}</text><text class="c-title">{{submission.song_name}}</text><text class="c-sub">{{submission.singer}}</text><view wx:if="{{submission.special_note}}" class="c-reply"><text class="c-caption">备注</text><text class="c-text">{{submission.special_note}}</text></view><text class="c-sub">已提交不代表已入选，请以已发布歌单为准。</text></block>
  </view></scroll-view><text class="c-error" wx:if="{{sheetError}}">{{sheetError}}</text><view class="c-actions c-sheet-actions"><button class="c-secondary" bindtap="closeSheet" disabled="{{busy}}">{{sheet === 'submission' ? '关闭' : '取消'}}</button><button class="c-primary" wx:if="{{sheet !== 'submission'}}" bindtap="{{sheet === 'alias' ? 'saveAlias' : 'saveAppearance'}}" disabled="{{busy}}">{{busy ? '保存中…' : '保存'}}</button></view></view></view>
<privacy-popup id="privacyPopup" />
<include src="../../templates/admin-feedback.wxml" />
