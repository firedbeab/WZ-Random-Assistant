@import "../../styles/community.wxss";
.c-sheet.compact .c-sheet-scroll { flex: none; height: 160rpx; }
.my-profile { margin: 0 0 36rpx; }.my-avatar { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; background: var(--accent-weak); color: var(--accent); font-size: 30rpx; font-weight: 650; border-radius: 28rpx; flex: none; }.my-alias { display: block; font-size: 38rpx; font-weight: 600; overflow-wrap: anywhere; line-height: 1.6; }.my-profile .c-caption { font-size: 22rpx; }.my-week-title { margin-top: 16rpx; }.my-week-link { justify-content: flex-start; margin-top: 14rpx; padding-left: 0; }.my-week-link image { width: 32rpx; height: 32rpx; margin-left: 10rpx; }.my-entries { padding: 0 28rpx; }.my-foot { text-align: center; margin-top: 32rpx; }.my-alias-field { font-size: 36rpx; text-align: center; height: 110rpx; }.my-palettes { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 16rpx; }.my-palette { margin: 0; min-width: 0; padding: 20rpx 4rpx; border: 1rpx solid var(--line); border-radius: var(--radius-md); background: transparent; color: var(--text-2); font-size: 24rpx; line-height: 1.5; }.my-palette.selected { background: var(--accent-weak); border-color: var(--accent); color: var(--accent); }.my-swatch { width: 48rpx; height: 48rpx; border-radius: 50%; margin: 0 auto 12rpx; }
