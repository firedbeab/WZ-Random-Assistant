@import "../../styles/community.wxss";
.my-profile { margin: 0 0 36rpx; }.my-avatar { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; background: var(--accent-weak); color: var(--accent); font-size: 30rpx; font-weight: 650; border-radius: 28rpx; flex: none; }.my-alias { display: block; font-size: 38rpx; font-weight: 600; overflow-wrap: anywhere; line-height: 1.6; }.my-profile .c-caption { font-size: 22rpx; }
.my-week-card { min-height: 342rpx; box-sizing: border-box; }.my-period { text-align: right; }.my-week-status { display: block; margin-top: 14rpx; font-size: 23rpx; line-height: 1.7; color: var(--text-2); }.my-week-title { margin-top: 8rpx; }.my-week-description { min-height: 88rpx; }.my-week-link { justify-content: flex-start; padding-left: 0; margin-top: 4rpx; }.my-week-link image { width: 32rpx; height: 32rpx; margin-left: 10rpx; }.my-week-link[disabled] { background: transparent; color: var(--text-3); }.my-refresh-error { color: var(--warn); margin-top: 4rpx; }
.my-entries { padding: 0 28rpx; }.my-foot { text-align: center; margin-top: 32rpx; }.my-alias-field { font-size: 34rpx; text-align: center; height: 100rpx; }
.my-palettes { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 10rpx; }.my-palette { margin: 0; min-width: 0; padding: 18rpx 2rpx; border: 1rpx solid var(--line); border-radius: var(--radius-md); background: transparent; color: var(--text-2); font-size: 23rpx; line-height: 1.5; }.my-palette.selected { background: var(--accent-weak); border-color: var(--accent); color: var(--accent); }.my-swatch { width: 44rpx; height: 44rpx; border-radius: 50%; margin: 0 auto 10rpx; }.my-modes { flex-wrap: nowrap; }.my-modes .c-chip { flex: 1; padding-left: 8rpx; padding-right: 8rpx; }
.my-custom-entry { margin-top: 20rpx; }.my-custom-arrow { transition: transform 240ms ease; }.my-custom-arrow.expanded { transform: rotate(180deg); }.my-sheet .c-sheet-body > block:first-child > .c-label:first-child { margin-top: 0; }.my-sheet .c-sheet-scroll { scrollbar-width: none; }.my-sheet .c-sheet-scroll::-webkit-scrollbar { width: 0; height: 0; display: none; }
.my-dialog-mask { position: fixed; inset: 0; z-index: 1100; display: flex; align-items: center; justify-content: center; padding: 32rpx; box-sizing: border-box; background: var(--mask); animation: admin-mask-in 180ms ease both; }.my-dialog { position: relative; width: 100%; max-width: 640rpx; padding: 36rpx 32rpx 32rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface); color: var(--text-1); box-shadow: var(--shadow-dialog); animation: my-dialog-in 180ms ease both; }.my-dialog .c-input-shell { margin-top: 28rpx; }.my-dialog .c-actions { padding-top: 28rpx; }.my-dialog-mask.dialog-closing { animation: admin-mask-out 180ms ease both; }.dialog-closing .my-dialog { animation: my-dialog-out 180ms ease both; pointer-events: none; }
@keyframes my-dialog-in { from { opacity: 0; transform: translateY(8rpx) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }@keyframes my-dialog-out { to { opacity: 0; transform: translateY(8rpx) scale(.98); } }
@media(prefers-reduced-motion:reduce) { .my-dialog-mask,.my-dialog { animation-duration: 1ms; }.my-custom-arrow { transition-duration: 1ms; } }
.my-week-action { min-height: 92rpx; }
