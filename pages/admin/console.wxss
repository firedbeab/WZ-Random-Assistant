@import "../../styles/admin.wxss";
page { background: var(--bg); color: var(--text-1); }
.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; padding-bottom: 150rpx; }
.hero { padding: 26rpx 30rpx; margin-bottom: 22rpx; color: var(--on-accent); border-radius: 22rpx; background: var(--accent); }
.hero-title { display: block; font-size: 38rpx; font-weight: 700; }
.hero-sub { display: block; margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; opacity: .82; }
.loading,.empty { padding: 80rpx 0; text-align: center; color: var(--text-3); font-size: 26rpx; }
.toolbar,.bulk-bar,.detail-head { display: flex; align-items: stretch; gap: 12rpx; flex-wrap: wrap; margin-bottom: 18rpx; }
.bulk-bar,.detail-head { justify-content: space-between; padding: 0 6rpx; color: var(--text-2); font-size: 24rpx; }
.field,.picker,.textarea { width: 100%; box-sizing: border-box; background: var(--surface); border: 2rpx solid var(--line); border-radius: 14rpx; font-size: 28rpx; color: var(--text-1); }
.field { height: 82rpx; padding: 0 22rpx; line-height: 82rpx; caret-color: var(--accent); -webkit-text-fill-color: var(--text-1); opacity: 1; }
.field:focus { border-color: var(--info); background: var(--surface); }
.field.compact { width: 270rpx; }
.toolbar .field:not(.compact) { flex: 1; min-width: 360rpx; }
.toolbar .search-field { flex-basis: 500rpx; }
.picker { display: flex; align-items: center; width: auto; min-width: 190rpx; min-height: 82rpx; padding: 0 22rpx; color: var(--info); background: var(--surface); }
.week-picker-wrap { flex: 1 1 430rpx; min-width: 0; }
.week-picker { width: 100%; box-sizing: border-box; color: var(--text-1); }
.toolbar > button { min-height: 82rpx; }
.picker.full { width: 100%; margin-bottom: 18rpx; background: var(--surface); }
.textarea { min-height: 150rpx; margin-top: 14rpx; padding: 20rpx 22rpx; line-height: 1.55; caret-color: var(--accent); -webkit-text-fill-color: var(--text-1); opacity: 1; }
.form-placeholder { color: var(--placeholder); -webkit-text-fill-color: var(--placeholder); opacity: 1; }
.card { padding: 26rpx; margin-bottom: 18rpx; border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); }
.card.tappable:active { background: var(--info-weak); }
.card.submission { display: flex; align-items: flex-start; gap: 14rpx; }
.check { margin-top: 4rpx; transform: scale(.84); }
.grow { flex: 1; min-width: 0; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.row.gap { margin-top: 24rpx; }
.item-title { font-size: 30rpx; font-weight: 650; color: var(--text-1); }
.muted,.note,.meta { display: block; margin-top: 8rpx; font-size: 23rpx; line-height: 1.45; }
.muted { color: var(--text-2); }.note { color: var(--warn); }.meta { color: var(--text-3); }
.tag { flex-shrink: 0; padding: 5rpx 12rpx; border-radius: 10rpx; background: var(--surface-2); color: var(--text-2); font-size: 20rpx; }
.tag.pending { background: var(--info-weak);color: var(--info); }.tag.overflow { background: var(--warn-weak);color: var(--warn); }.tag.carryover { background: var(--carryover-weak);color: var(--carryover); }.tag.selected,.tag.published { background: var(--success-weak);color: var(--success); }.tag.removed,.tag.withdrawn { background: var(--danger-weak);color: var(--danger); }
.side-actions { display: flex; flex-direction: column; gap: 10rpx; }
button { margin: 0; border-radius: 12rpx; font-size: 26rpx; }
button::after { border: none; }
.small,.tiny { min-height: 0; line-height: 1.2; padding: 14rpx 22rpx; background: var(--surface-2); color: var(--text-2); }
.tiny { padding: 10rpx 16rpx; font-size: 22rpx; }
.primary { background: var(--accent); color: var(--on-accent); }.secondary { background: var(--surface-2); color: var(--text-2); }.danger { background: var(--danger-weak); color: var(--danger); }.green { background: var(--success-weak);color: var(--success); }
.schedule-item { margin-top: 22rpx; padding: 22rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: var(--surface-2); }
.schedule-item .field { margin-bottom: 16rpx; }
.input-caption { display: block; margin: 0 0 8rpx 4rpx; color: var(--text-2); font-size: 23rpx; font-weight: 600; }
.input-caption.card-caption { margin-top: 18rpx; }
.input-caption.modal-caption { margin-top: 20rpx; }
.label { display: block; color: var(--text-2); font-size: 25rpx; font-weight: 600; }
.sticky-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: var(--surface-translucent); box-shadow: var(--shadow-sm); }
.sticky-actions button { flex: 1; }
.json { display: block; margin-top: 16rpx; padding: 18rpx; border-radius: 12rpx; background: var(--surface-2); color: var(--text-2); white-space: pre-wrap; word-break: break-all; font-family: monospace; font-size: 21rpx; line-height: 1.55; }
.counter-num { font-size: 42rpx; font-weight: 750; color: var(--info); }
.status-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.status-grid text { padding: 8rpx 14rpx; border-radius: 10rpx; background: var(--bg); color: var(--text-2); font-size: 22rpx; }
.card > .field { margin-top: 14rpx; }.card > button { width: 100%; margin-top: 16rpx; }
.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 30rpx; background: var(--mask); }
.modal-card { width: 100%; box-sizing: border-box; padding: 34rpx; border-radius: 24rpx; background: var(--surface); }
.modal-card .field { margin-top: 0; }
.modal-card .row button { flex: 1; }

@media (max-width: 360px) {
  .page { padding: 18rpx; padding-bottom: 150rpx; }
  .toolbar > picker,.toolbar > input,.toolbar > button { width: 100%; flex-basis: 100%; }
  .toolbar .field:not(.compact) { min-width: 0; }
  .card { padding: 22rpx; }
  .card.submission { flex-wrap: wrap; }
  .side-actions { width: 100%; flex-direction: row; justify-content: flex-end; }
}

/* I版：层级与密度统一，记录列表不重复展示总统计。 */
.page { padding: 24rpx 32rpx 180rpx; background: var(--gradient-open); }
.hero-sub { display: block; font-size: 24rpx; line-height: 1.7; color: var(--text-3); margin: -4rpx 4rpx 24rpx; opacity: 1; }
.card { padding: 28rpx 30rpx; border-radius: var(--radius-lg); }
.card.tappable:active { background: var(--surface-2); }
.toolbar { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 14rpx; }
.toolbar .search-field { min-width: 0; grid-column: 1; width: 100%; }.toolbar .week-picker-wrap { min-width: 0; }.toolbar > button { width: 100%; margin: 0; }
.picker { min-width: 0; min-height: 88rpx; color: var(--text-2); font-size: 26rpx; }.field { min-height: 88rpx; }.toolbar .field:not(.compact) { min-width: 0; }
.small,.tiny { display: inline-flex; justify-content: center; align-items: center; min-height: 88rpx; padding: 0 20rpx; font-size: 26rpx; border-radius: var(--radius-md); box-sizing: border-box; }.tiny { font-size: 24rpx; padding: 0 14rpx; }
.bulk-bar { align-items: center; min-height: 88rpx; margin-bottom: 12rpx; }.bulk-bar .danger { background: transparent; }
.submission .meta { overflow-wrap: anywhere; }.item-title { overflow-wrap: anywhere; }.note { color: var(--text-2); }
.detail-head { align-items: center; gap: 12rpx; font-size: 24rpx; line-height: 1.7; }.detail-head > text { flex: 1; color: var(--text-2); }
.schedule-item { background: transparent; padding: 24rpx 0 0; border: 0; border-top: 1rpx solid var(--line); border-radius: 0; }.schedule-item .field { background: var(--surface-2); }
.read-song { display: flex; gap: 20rpx; padding: 24rpx 0; }.read-song > view { flex: 1; min-width: 0; }.read-index { font-size: 24rpx; color: var(--text-3); padding-top: 4rpx; }.read-line { display: flex; gap: 12rpx; align-items: baseline; flex-wrap: wrap; font-size: 32rpx; font-weight: 600; overflow-wrap: anywhere; }.read-singer { color: var(--text-2); font-size: 26rpx; font-weight: 400; }.read-note { display: block; padding-left: 16rpx; border-left: 3rpx solid var(--line); margin-top: 10rpx; line-height: 1.7; font-size: 24rpx; color: var(--text-2); white-space: pre-wrap; overflow-wrap: anywhere; }
.sticky-actions { background: var(--surface); border-top: 1rpx solid var(--line); box-shadow: none; }.sticky-actions:empty { display: none; }.sticky-actions button { min-height: 88rpx; line-height: 88rpx; }.outlined { border: 1rpx solid var(--danger); background: transparent; }
.event-list { border-radius: var(--radius-lg); overflow: hidden; background: var(--surface); box-shadow: var(--shadow-sm); }.event-item + .event-item { border-top: 1rpx solid var(--line); }
.event-summary { padding: 22rpx 26rpx; min-height: 100rpx; box-sizing: border-box; }.event-summary:active { background: var(--surface-2); }.event-top { display: flex; align-items: center; gap: 12rpx; }.event-title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 550; line-height: 1.6; }.event-category { font-size: 21rpx; color: var(--text-3); white-space: nowrap; }.event-chevron { width: 24rpx; color: var(--text-3); transition: transform 280ms ease; }.event-chevron.expanded { transform: rotate(180deg); }
.event-meta { display: block; margin-top: 4rpx; font-size: 22rpx; line-height: 1.6; color: var(--text-3); font-variant-numeric: tabular-nums; }.event-reason { display: block; margin-top: 4rpx; color: var(--text-2); font-size: 24rpx; line-height: 1.6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.event-expand { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 280ms ease, opacity 220ms ease; }.event-expand.expanded { grid-template-rows: 1fr; opacity: 1; }.event-inner { min-height: 0; overflow: hidden; }.event-inner .json { margin: 0 26rpx 22rpx; font-size: 23rpx; }
.modal { align-items: flex-end; padding: 0; animation: admin-mask-in 240ms ease both; }.modal-card { max-height: 82vh; overflow-y: auto; padding: 34rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; animation: admin-drawer-in 280ms ease both; }.modal.drawer-closing { animation: admin-mask-out 200ms ease both; pointer-events: none; }.drawer-closing .modal-card { animation: admin-drawer-out 200ms ease both; }.modal-card .row button { min-height: 88rpx; line-height: 88rpx; }
@media (max-width: 360px) { .page { padding: 20rpx 24rpx 180rpx; }.toolbar > picker,.toolbar > input,.toolbar > button { width: auto; }.card { padding: 24rpx; }.card.submission { flex-wrap: nowrap; }.side-actions { width: auto; flex-direction: column; } }
@media (prefers-reduced-motion: reduce) { .event-expand,.event-chevron { transition-duration: 1ms; }.modal,.modal-card,.modal.drawer-closing,.drawer-closing .modal-card { animation-duration: 1ms; } }
