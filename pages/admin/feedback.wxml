<page-meta page-style="{{appearanceStyle}} {{sheet || _adminDialogVisible ? 'overflow:hidden;' : 'overflow:auto;'}}" />
<import src="../../templates/community.wxml" />
<view class="info-page community"><view class="info-head"><view class="info-heading-row"><text class="info-title">反馈与投票</text><appearance-toggle /></view><text class="c-caption" wx:if="{{isTestMode}}">测试模式 · 独立于正式反馈</text></view><view class="c-content"><view class="sub-heading"><button class="sub-back" bindtap="goBack" aria-label="返回管理"><image src="{{themeIcons.back}}" /></button><text>{{tab === 'feedback' ? '反馈管理' : '功能投票'}}</text><button wx:if="{{allowed && tab === 'polls'}}" class="c-link" bindtap="newPoll">＋ 新建</button></view>
<view class="c-tabs" wx:if="{{allowed}}"><button class="c-tab {{tab === 'feedback' ? 'active' : ''}}" bindtap="switchTab" data-tab="feedback">使用反馈</button><button class="c-tab {{tab === 'polls' ? 'active' : ''}}" bindtap="switchTab" data-tab="polls">功能投票</button></view>
<block wx:if="{{allowed}}"><view wx:if="{{tab === 'feedback'}}" class="c-motion"><view class="c-chips"><button wx:for="{{statuses}}" wx:key="id" class="c-chip {{status === item.id ? 'active' : ''}}" bindtap="filter" data-id="{{item.id}}">{{item.label}}</button></view><view class="c-row c-between" wx:if="{{userKey}}"><text class="c-caption">用户 {{userKey}} 的反馈</text><button class="c-link" bindtap="clearUser">查看全部用户</button></view><template is="community-feedback-list" data="{{entries, admin:true, themeIcons}}" /></view><view wx:else class="c-motion"><template is="community-polls" data="{{polls, busy, admin:true}}" /></view></block>
<view class="c-state" wx:if="{{error}}"><text class="c-title">暂时无法读取</text><text class="c-sub">{{error}}</text><button class="c-link" bindtap="retry">重新加载</button></view><view class="c-state" wx:elif="{{loading}}"><text class="c-title">正在加载</text></view><view class="c-state" wx:elif="{{tab === 'feedback' ? !entries.length : !polls.length}}"><text class="c-title">{{tab === 'feedback' ? '暂无符合条件的反馈' : '还没有功能投票'}}</text><text class="c-sub">{{tab === 'feedback' ? '用户提交后会在这里展示。' : '可以先发起一个简单的单选话题。'}}</text></view><button class="c-link" wx:if="{{hasMore && !loading}}" bindtap="loadMore">查看更多</button></view></view>
<view wx:if="{{sheet}}" class="admin-drawer-mask c-sheet {{sheetClosing ? 'drawer-closing' : ''}}"><view class="drawer-backdrop" catchtap="closeSheet" catchtouchmove="adminDrawerNoop" /><view class="admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeSheet"><view class="drawer-handle" data-drawer-drag="true" catchtouchmove="adminDrawerNoop" /><view class="c-sheet-head"><text class="modal-title">{{sheet === 'detail' ? '处理反馈' : '新建功能投票'}}</text></view><scroll-view class="c-sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="c-sheet-body"><block wx:if="{{sheet === 'detail'}}"><view class="c-row c-between"><view><text class="c-title">{{detail.alias}}</text><text class="c-caption">编号 {{detail.userKey}}</text></view><button class="c-link" bindtap="sameUser" disabled="{{dirty || busy}}">同一用户</button></view><text class="c-caption">{{detail.category}} · {{detail.date}} · v{{detail.version}}</text><text class="c-text admin-feedback-content">{{detail.content}}</text><text class="c-label">处理状态</text><view class="c-chips"><button wx:for="{{processStatuses}}" wx:key="id" class="c-chip {{selectedStatus === item.id ? 'active' : ''}}" bindtap="selectStatus" data-id="{{item.id}}" disabled="{{busy}}">{{item.label}}</button></view><text class="c-label">回复用户（选填）</text><view class="c-input-shell {{focusedField === 'reply' ? 'focused' : ''}}"><textarea class="c-field c-textarea" value="{{reply}}" bindinput="inputReply" maxlength="500" disabled="{{busy}}" placeholder="简短说明处理结果或后续安排" placeholder-class="c-placeholder" bindfocus="onCommunityFieldFocus" bindblur="onCommunityFieldBlur" data-focus-field="reply" /></view><text class="c-caption">{{reply.length}} / 500 · 保存后用户可在反馈详情查看</text></block>
<block wx:else><text class="c-label">投票标题</text><view class="c-input-shell {{focusedField === 'title' ? 'focused' : ''}}"><input class="c-field" value="{{title}}" bindinput="inputPoll" data-field="title" maxlength="50" disabled="{{busy}}" placeholder="你希望优先更新什么？" placeholder-class="c-placeholder" bindfocus="onCommunityFieldFocus" bindblur="onCommunityFieldBlur" data-focus-field="title" /></view><text class="c-label">补充说明（选填）</text><view class="c-input-shell {{focusedField === 'description' ? 'focused' : ''}}"><textarea class="c-field c-textarea" value="{{description}}" bindinput="inputPoll" data-field="description" maxlength="100" disabled="{{busy}}" placeholder="说明这次投票的范围" placeholder-class="c-placeholder" bindfocus="onCommunityFieldFocus" bindblur="onCommunityFieldBlur" data-focus-field="description" /></view><text class="c-label">单选选项 · 2–4 项</text><view class="c-options-edit" wx:for="{{options}}" wx:key="index"><view class="c-input-shell {{focusedField === ('option-' + index) ? 'focused' : ''}}"><input class="c-field" value="{{item}}" bindinput="inputOption" data-index="{{index}}" maxlength="30" disabled="{{busy}}" placeholder="选项 {{index + 1}}" placeholder-class="c-placeholder" bindfocus="onCommunityFieldFocus" bindblur="onCommunityFieldBlur" data-focus-field="option-{{index}}" /></view><button class="c-link" wx:if="{{options.length > 2}}" bindtap="removeOption" data-index="{{index}}" disabled="{{busy}}">移除</button></view><button class="c-link" wx:if="{{options.length < 4}}" bindtap="addOption" disabled="{{busy}}">＋ 添加选项</button><text class="c-label">持续时间</text><view class="c-chips"><button wx:for="{{durations}}" wx:key="*this" class="c-chip {{days === item ? 'active' : ''}}" bindtap="selectDays" data-days="{{item}}" disabled="{{busy}}">{{item}} 天</button></view><text class="c-sub">发布后选项固定；截止前用户可以改票。结果始终保留。</text></block></view></scroll-view><text class="c-error" wx:if="{{sheetError}}">{{sheetError}}</text><view class="c-actions c-sheet-actions"><button class="c-secondary" bindtap="closeSheet" disabled="{{busy}}">取消</button><button class="c-primary" bindtap="{{sheet === 'detail' ? 'saveReply' : 'createPoll'}}" disabled="{{busy}}">{{busy ? '保存中…' : sheet === 'detail' ? '保存处理结果' : '发布投票'}}</button></view></view></view>
<privacy-popup id="privacyPopup" /><include src="../../templates/admin-feedback.wxml" />
