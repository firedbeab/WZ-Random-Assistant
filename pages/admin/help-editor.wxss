@import "../../styles/admin.wxss";
page {
  min-height: 100%;
  background: var(--bg);
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.form-card,
.preview-card {
  margin-bottom: 22rpx;
  padding: 30rpx;
  border-radius: 22rpx;
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}

.field {
  position: relative;
  margin-bottom: 34rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--text-1);
  font-size: 27rpx;
  font-weight: 600;
}

.field-input,
.content-input {
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface-2);
  color: var(--text-1);
  font-size: 27rpx;
  box-sizing: border-box;
}

.field-input {
  height: 84rpx;
  padding: 0 24rpx;
  line-height: 84rpx;
  caret-color: var(--accent);
  -webkit-text-fill-color: var(--text-1);
  opacity: 1;
}

.content-input {
  min-height: 260rpx;
  line-height: 1.7;
  -webkit-text-fill-color: var(--text-1);
  opacity: 1;
}

.field-count {
  display: block;
  margin-top: 8rpx;
  color: var(--text-3);
  font-size: 21rpx;
  text-align: right;
}

.image-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.image-subtitle {
  display: block;
  color: var(--text-3);
  font-size: 22rpx;
}

.image-total {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.editor-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 24rpx;
}

.editor-image-item {
  width: calc(50% - 9rpx);
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface-2);
}

.editor-image {
  width: 100%;
  height: 210rpx;
  background: var(--surface-2);
}

.image-actions {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  padding: 14rpx 8rpx;
}

.image-action {
  color: var(--info);
  font-size: 22rpx;
}

.image-action.danger {
  color: var(--danger);
}

.choose-image-btn {
  height: 76rpx;
  margin-top: 24rpx;
  border: 1rpx dashed var(--accent);
  border-radius: 14rpx;
  background: var(--accent-weak);
  color: var(--accent);
  font-size: 26rpx;
  line-height: 74rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.choose-image-btn::after,
.action-btn::after {
  border: none;
}

.choose-image-btn[disabled] {
  border-color: var(--line);
  background: var(--surface-2);
  color: var(--text-3);
}

.preview-card {
  border: 2rpx solid var(--accent-weak);
}

.preview-label {
  display: block;
  margin-bottom: 20rpx;
  color: var(--accent);
  font-size: 23rpx;
  font-weight: 600;
}

.preview-title {
  display: block;
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 700;
}

.preview-summary {
  display: block;
  margin-top: 8rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

.preview-content {
  display: block;
  margin-top: 24rpx;
  color: var(--text-2);
  font-size: 27rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.preview-images {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.preview-image-wrap {
  position: relative;
  width: calc(50% - 7rpx);
  height: 210rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-image-wrap.single {
  width: 100%;
  height: 330rpx;
}
.preview-image { width: 100%; height: 100%; }
.preview-image-more { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, .5); color: var(--on-overlay); font-size: 28rpx; font-weight: 600; }
.preview-image-hint { display: block; margin-top: 12rpx; color: var(--text-2); font-size: 22rpx; line-height: 1.8; text-align: center; }

.bottom-spacer {
  height: 130rpx;
}

.bottom-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--surface-translucent);
  box-sizing: border-box;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  margin: 0;
  border-radius: 14rpx;
  font-size: 25rpx;
  line-height: 76rpx;
  overflow: hidden;
  border: none;
  box-sizing: border-box;
}

.action-btn.preview {
  background: var(--surface-2);
  color: var(--text-2);
}

.action-btn.draft {
  background: var(--info-weak);
  color: var(--info);
}

.action-btn.publish {
  background: var(--accent);
  color: var(--on-accent);
}
.page { min-height: 100vh; padding: 24rpx 32rpx; background: var(--gradient-open); }
.form-card,.preview-card { border-radius: var(--radius-lg); padding: 30rpx; }
.field-label { font-size: 26rpx; color: var(--text-2); }.field-input,.content-input { font-size: 28rpx; border-radius: var(--radius-md); }
.content-input { min-height: 280rpx; }.image-actions { gap: 0; padding: 0; }.image-action { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--text-2); }
.image-action + .image-action { border-left: 1rpx solid var(--line); }.action-btn { min-height: 88rpx; }.action-btn.draft { color: var(--text-2); background: var(--surface-2); }.preview-card { border: none; animation: admin-page-in 260ms ease both; }
@media (prefers-reduced-motion: reduce) { .preview-card { animation-duration: 1ms; } }
.bottom-actions { gap: 20rpx; background: var(--surface); }.bottom-actions .action-btn { display: flex; align-items: center; justify-content: center; min-height: 96rpx; height: auto; padding: 20rpx 12rpx; border-radius: var(--radius-lg); font-size: 27rpx; line-height: 1.5; }.bottom-actions .publish { font-weight: 600; }.form-card .field-label { font-size: 26rpx; font-weight: 550; }.image-heading { gap: 20rpx; }.image-total { padding-top: 2rpx; white-space: nowrap; }.choose-image-btn { min-height: 88rpx; height: auto; display: flex; align-items: center; justify-content: center; padding: 18rpx 20rpx; line-height: 1.5; }.field-input,.content-input { border-width: 1rpx; }.preview-title { color: var(--text-1); }.preview-content,.preview-summary { color: var(--text-2); }
