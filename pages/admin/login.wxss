page {
  background: var(--gradient-page);
  height: 100vh;
}

.login-container {
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}


.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.header .icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.header .title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-1);
  display: block;
  margin-bottom: 10rpx;
}

.header .desc {
  font-size: 26rpx;
  color: var(--text-2);
}


.input-group {
  width: 100%;
  min-height: 92rpx;
  box-sizing: border-box;
  background: var(--surface);
  padding: 0 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--line);
  margin-bottom: 60rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.code-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: var(--text-1);
  caret-color: var(--accent);
  -webkit-text-fill-color: var(--text-1);
  opacity: 1;
}

.toggle-btn {
  font-size: 24rpx;
  color: var(--accent);
  margin-left: 20rpx;
}


.btn-verify {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: var(--accent);
  color: var(--on-accent);
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-bottom: 40rpx;
}

.btn-verify[disabled] {
  background-color: var(--accent-disabled);
}
.btn-verify[disabled]:not([type]) { background: var(--accent-disabled); color: var(--on-accent); }
.code-input { font-family: var(--font-code); padding: 0; min-width: 0; }
.login-container { box-sizing: border-box; width: 100%; }.toggle-btn { min-height: 88rpx; display: flex; align-items: center; justify-content: center; flex: none; }


.footer {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
}
