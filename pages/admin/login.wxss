/* pages/admin/login.wxss */
page {
  background-color: #f6f7f9; /* 确保背景不是白色，能看见内容 */
  height: 100vh;
}

.login-container {
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头部样式 */
.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.header .icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.header .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333; /* 强制黑色 */
  display: block;
  margin-bottom: 10rpx;
}

.header .desc {
  font-size: 26rpx;
  color: #888;
}

/* 输入框样式 */
.input-group {
  width: 100%;
  min-height: 92rpx;
  box-sizing: border-box;
  background: #fff;
  padding: 0 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e0e4e8;
  margin-bottom: 60rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.code-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #333;
  caret-color: #07c160;
  -webkit-text-fill-color: #333;
  opacity: 1;
}

.toggle-btn {
  font-size: 24rpx;
  color: #07c160;
  margin-left: 20rpx;
}

/* 按钮样式 */
.btn-verify {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-bottom: 40rpx;
}

.btn-verify[disabled] {
  background-color: #a8e6cf;
}

/* 底部文字 */
.footer {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}
