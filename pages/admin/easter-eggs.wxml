<page-meta page-style="{{appearanceStyle}}" />
<view class="appearance-toolbar"><appearance-toggle /></view>
<view class="egg-admin-page">
  <view class="test-mode-banner" wx:if="{{isTestMode}}">测试彩蛋 · 仅维护 test_ 配置和 test/ 图片</view>
  <block wx:if="{{allowed}}">
    <view class="page-heading"><text>🐱 彩蛋管理</text><view class="action primary {{busy ? 'disabled' : ''}}" bindtap="edit">＋ 添加条目</view></view>
    <text class="page-hint">每个条目一张照片；上方、下方文字留空会使用默认文案。启用的条目随机展示。</text>
    <view wx:if="{{loading}}" class="empty">正在加载…</view>
    <view wx:elif="{{!entries.length}}" class="empty">还没有彩蛋照片，先添加一张吧。</view>
    <view wx:for="{{entries}}" wx:key="id" class="entry-card">
      <image src="{{item.fileID}}" mode="aspectFill" class="entry-photo" bindtap="preview" data-src="{{item.fileID}}" />
      <view class="entry-info"><view class="entry-heading"><text class="entry-title">{{item.displayTop}}</text><text class="entry-status {{item.enabled ? 'enabled' : ''}}">{{item.enabled ? '已启用' : '未启用'}}</text></view><text class="entry-caption">{{item.displayBottom}}</text>
        <view class="entry-actions {{busy ? 'disabled' : ''}}"><view class="action" bindtap="edit" data-id="{{item.id}}">编辑</view><view class="action" bindtap="changeEnabled" data-id="{{item.id}}">{{item.enabled ? '停用' : '启用'}}</view><view class="action danger" bindtap="remove" data-id="{{item.id}}">删除</view></view>
      </view>
    </view>
  </block>
</view>
<view wx:if="{{editing}}" class="editor-mask" catchtap="closeEditor">
  <scroll-view scroll-y class="editor-card" catchtap="noop">
    <view class="editor-heading"><text>{{id ? '编辑彩蛋' : '添加彩蛋'}}</text><view bindtap="closeEditor">×</view></view>
    <view class="editor-photo" bindtap="chooseImage"><image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit" /><text wx:else>＋ 选择小猫照片</text></view>
    <view class="photo-options"><view bindtap="chooseImage">{{imagePath ? '换一张照片' : 'JPG / PNG / WebP，最大2MB'}}</view><view wx:if="{{imagePath}}" bindtap="preview">查看大图</view></view>
    <text class="field-label">上方文字（可留空）</text><input value="{{topText}}" maxlength="40" placeholder="{{previewTop}}" placeholder-class="form-placeholder" bindinput="input" data-field="topText" disabled="{{busy}}" />
    <text class="field-label">下方文字（可留空）</text><textarea value="{{bottomText}}" maxlength="100" placeholder="今天的小幸运，是和小猫碰个面。" placeholder-class="form-placeholder" bindinput="input" data-field="bottomText" disabled="{{busy}}" />
    <view class="enabled-field"><text>启用此条目</text><switch checked="{{enabled}}" color="{{themeColors.accent}}" bindchange="toggleEditor" disabled="{{busy}}" /></view>
    <view class="preview-label">弹窗文案预览</view><view class="text-preview"><text class="preview-top">{{previewTop}}</text><text class="preview-bottom">{{previewBottom}}</text></view>
    <view class="editor-actions"><view class="action" bindtap="closeEditor">取消</view><view class="action primary {{busy ? 'disabled' : ''}}" bindtap="save">{{busy ? '保存中…' : '保存彩蛋'}}</view></view>
  </scroll-view>
</view>
<privacy-popup />
