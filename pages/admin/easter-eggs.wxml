<page-meta page-style="{{appearanceStyle}} {{editing || _adminDialogVisible ? 'overflow:hidden;' : 'overflow:auto;'}}" />
<view class="egg-admin-page admin-page-enter">
<view class="admin-hero"><view class="admin-heading"><text class="admin-title">管理后台</text><appearance-toggle /></view><text class="environment-tag" wx:if="{{isTestMode}}">测试模式</text></view>
  <block wx:if="{{allowed}}">
    <view class="page-heading"><button class="sub-back" bindtap="backFromEditor" aria-label="返回管理"><image src="{{themeIcons.back}}" /></button><text class="grow">彩蛋管理</text><view class="action primary {{busy ? 'disabled' : ''}}" bindtap="edit">＋ 添加条目</view></view>
    <text class="page-hint">每个条目一张照片；上方、下方文字留空会使用默认文案。启用的条目随机展示。</text>
    <view wx:if="{{loading && !entries.length}}" class="empty">正在加载…</view>
    <view wx:elif="{{!entries.length}}" class="empty">还没有彩蛋照片，先添加一张吧。</view>
    <view wx:for="{{entries}}" wx:key="id" class="entry-card">
      <image src="{{item.fileID}}" mode="aspectFill" class="entry-photo" lazy-load bindtap="preview" data-src="{{item.fileID}}" />
      <view class="entry-info"><view class="entry-heading"><text class="entry-title">{{item.displayTop}}</text><text class="entry-status {{item.enabled ? 'enabled' : ''}}">{{item.enabled ? '已启用' : '未启用'}}</text></view><text class="entry-caption">{{item.displayBottom}}</text>
        <view class="entry-actions {{busy ? 'disabled' : ''}}"><view class="action" bindtap="edit" data-id="{{item.id}}">编辑</view><view class="action" bindtap="changeEnabled" data-id="{{item.id}}">{{item.enabled ? '停用' : '启用'}}</view><view class="action danger" bindtap="remove" data-id="{{item.id}}">删除</view></view>
      </view>
    </view>
  </block>
</view>
<view wx:if="{{editing}}" id="easter-editor-mask" class="editor-mask admin-drawer-mask {{editorClosing ? 'drawer-closing' : ''}}" bindtap="onAdminDrawerMaskTap" data-close="closeEditor"><view class="drawer-backdrop" id="easter-editor-mask-backdrop" bindtap="onAdminDrawerMaskTap" catchtouchmove="adminDrawerNoop" data-close="closeEditor" />
  <view class="egg-editor-shell admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeEditor">
    <view class="drawer-handle" data-drawer-drag="true" catchtouchmove="adminDrawerNoop" />
    <view class="egg-editor-heading" data-drawer-drag="true" catchtouchmove="adminDrawerNoop"><text data-drawer-drag="true" catchtouchmove="adminDrawerNoop">{{id ? '编辑彩蛋' : '添加彩蛋'}}</text><button class="egg-editor-close" bindtap="closeEditor" disabled="{{busy}}" aria-label="关闭编辑"><image src="{{themeIcons.close}}" /></button></view>
    <scroll-view scroll-y class="egg-editor-scroll" show-scrollbar="{{false}}">
      <view class="egg-editor-body">
        <text class="egg-edit-hint">直接编辑上下文案，留空使用默认内容。</text>
        <view class="egg-editor-stage">
          <textarea class="egg-title-editor" auto-height value="{{topText}}" maxlength="40" placeholder="{{previewTop}}" placeholder-class="egg-title-placeholder" bindinput="input" data-field="topText" disabled="{{busy}}" aria-label="上方文字，可留空" />
          <view class="egg-stage-photo"><image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit" bindtap="preview" data-src="{{imagePath}}" /><text wx:else>请在下方选择照片</text></view>
          <text class="egg-photo-hint" wx:if="{{imagePath}}">点击图片查看大图</text>
          <textarea class="egg-description-editor" auto-height value="{{bottomText}}" maxlength="100" placeholder="{{previewBottom}}" placeholder-class="form-placeholder" bindinput="input" data-field="bottomText" disabled="{{busy}}" aria-label="下方描述，可留空" />
        </view>
        <button class="egg-replace-photo" bindtap="chooseImage" disabled="{{busy}}">{{imagePath ? '换一张照片' : '选择照片'}}</button>
        <view class="enabled-field"><text>启用此条目</text><switch checked="{{enabled}}" color="{{themeColors.accent}}" bindchange="toggleEditor" disabled="{{busy}}" /></view>
      </view>
    </scroll-view>
    <view class="egg-editor-footer"><button class="egg-cancel" bindtap="closeEditor" disabled="{{busy}}">取消</button><button class="egg-save" bindtap="save" disabled="{{busy}}">{{busy ? '保存中…' : '保存彩蛋'}}</button></view>
  </view>
</view>
<privacy-popup />

<include src="../../templates/admin-feedback.wxml" />
