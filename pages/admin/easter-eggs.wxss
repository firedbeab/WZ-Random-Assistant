page { background: #f0f3f1; }
.egg-admin-page { padding: 28rpx; }
.page-heading, .entry-heading, .editor-heading, .enabled-field { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.page-heading { margin: 28rpx 0 16rpx; font-size: 35rpx; font-weight: 700; color: #294834; }
.page-hint { display: block; color: #839188; font-size: 23rpx; line-height: 1.7; margin-bottom: 28rpx; }
.action { display: flex; align-items: center; justify-content: center; padding: 16rpx 22rpx; border-radius: 12rpx; font-size: 24rpx; line-height: 1.25; box-sizing: border-box; background: #edf3ef; color: #48735a; }
.primary { background: #2d8057; color: #fff; }
.danger { color: #ca5858; background: #fff0f0; }
.disabled { opacity: .5; pointer-events: none; }
.empty { text-align: center; padding: 70rpx 0; color: #97a299; font-size: 26rpx; }
.entry-card { background: #fff; padding: 22rpx; border-radius: 22rpx; display: flex; gap: 22rpx; margin-bottom: 22rpx; }
.entry-photo { flex-shrink: 0; width: 150rpx; height: 170rpx; border-radius: 16rpx; background: #eef3ed; }
.entry-info { flex: 1; min-width: 0; }
.entry-heading { align-items: flex-start; }
.entry-title { font-size: 27rpx; color: #35513f; font-weight: 600; overflow-wrap: break-word; flex: 1; min-width: 0; }
.entry-status { flex-shrink: 0; padding: 7rpx 10rpx; font-size: 19rpx; line-height: 1.2; border-radius: 8rpx; background: #eee; color: #999; }
.entry-status.enabled { background: #e4f5e9; color: #46945d; }
.entry-caption { display: block; font-size: 23rpx; color: #8a978e; margin: 14rpx 0; line-height: 1.5; }
.entry-actions, .editor-actions { display: flex; gap: 12rpx; }
.entry-actions .action { padding: 12rpx 20rpx; font-size: 22rpx; }
.editor-mask { position: fixed; inset: 0; z-index: 1000; background: rgba(20, 35, 28, .5); display: flex; align-items: center; justify-content: center; padding: 26rpx; box-sizing: border-box; }
.editor-card { width: 100%; max-height: 88vh; border-radius: 24rpx; background: #fff; padding: 28rpx; box-sizing: border-box; }
.editor-heading { font-size: 31rpx; font-weight: 600; color: #36503e; margin-bottom: 20rpx; }
.editor-heading view { padding: 4rpx 12rpx; color: #9ba69f; font-size: 42rpx; }
.editor-photo { height: 230rpx; border-radius: 16rpx; background: #f1f5ef; display: flex; align-items: center; justify-content: center; color: #829686; font-size: 25rpx; overflow: hidden; }
.editor-photo image { width: 100%; height: 100%; }
.photo-options { display: flex; justify-content: space-between; margin-top: 14rpx; font-size: 22rpx; color: #568167; }
.field-label { display: block; font-size: 24rpx; color: #65796b; margin: 22rpx 0 12rpx; }
input, textarea { width: 100%; box-sizing: border-box; background: #f4f6f3; padding: 18rpx; border-radius: 12rpx; font-size: 26rpx; color: #345640; }
input { height: 78rpx; } textarea { height: 126rpx; }
.enabled-field { margin: 18rpx 0; font-size: 25rpx; color: #65796b; }
.preview-label { font-size: 20rpx; color: #9ba59d; margin-top: 12rpx; }
.text-preview { padding: 18rpx; background: #f5f8f4; border-radius: 12rpx; margin-top: 12rpx; text-align: center; }
.preview-top { display: block; font-size: 26rpx; color: #365e44; font-weight: 600; }
.preview-bottom { display: block; margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; color: #87988b; }
.editor-actions { margin: 24rpx 0 12rpx; } .editor-actions .action { flex: 1; padding: 22rpx; }
