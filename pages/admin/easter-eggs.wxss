@import "../../styles/admin.wxss";
page { background: var(--bg); }
.egg-admin-page { padding: 28rpx; }
.page-heading, .entry-heading, .editor-heading, .enabled-field { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.page-heading { margin: 28rpx 0 16rpx; font-size: 35rpx; font-weight: 700; color: var(--text-1); }
.page-hint { display: block; color: var(--text-3); font-size: 23rpx; line-height: 1.7; margin-bottom: 28rpx; }
.action { display: flex; align-items: center; justify-content: center; padding: 16rpx 22rpx; border-radius: 12rpx; font-size: 24rpx; line-height: 1.25; box-sizing: border-box; background: var(--surface-2); color: var(--text-2); }
.primary { background: var(--accent); color: var(--on-accent); }
.danger { color: var(--danger); background: var(--danger-weak); }
.disabled { opacity: .5; pointer-events: none; }
.empty { text-align: center; padding: 70rpx 0; color: var(--text-3); font-size: 26rpx; }
.entry-card { background: var(--surface); padding: 22rpx; border-radius: 22rpx; display: flex; gap: 22rpx; margin-bottom: 22rpx; }
.entry-photo { flex-shrink: 0; width: 150rpx; height: 170rpx; border-radius: 16rpx; background: var(--surface-2); }
.entry-info { flex: 1; min-width: 0; }
.entry-heading { align-items: flex-start; }
.entry-title { font-size: 27rpx; color: var(--text-1); font-weight: 600; overflow-wrap: break-word; flex: 1; min-width: 0; }
.entry-status { flex-shrink: 0; padding: 7rpx 10rpx; font-size: 19rpx; line-height: 1.2; border-radius: 8rpx; background: var(--line); color: var(--text-3); }
.entry-status.enabled { background: var(--success-weak); color: var(--success); }
.entry-caption { display: block; font-size: 23rpx; color: var(--text-3); margin: 14rpx 0; line-height: 1.5; }
.entry-actions, .editor-actions { display: flex; gap: 12rpx; }
.entry-actions .action { padding: 12rpx 20rpx; font-size: 22rpx; }
.editor-mask { position: fixed; inset: 0; z-index: 1000; background: var(--mask); display: flex; align-items: center; justify-content: center; padding: 26rpx; box-sizing: border-box; }
.editor-card { width: 100%; max-height: 88vh; border-radius: 24rpx; background: var(--surface); padding: 28rpx; box-sizing: border-box; }
.editor-heading { font-size: 31rpx; font-weight: 600; color: var(--text-1); margin-bottom: 20rpx; }
.editor-heading view { padding: 4rpx 12rpx; color: var(--text-3); font-size: 42rpx; }
.editor-photo { height: 230rpx; border-radius: 16rpx; background: var(--surface-2); display: flex; align-items: center; justify-content: center; color: var(--text-3); font-size: 25rpx; overflow: hidden; }
.editor-photo image { width: 100%; height: 100%; }
.photo-options { display: flex; justify-content: space-between; margin-top: 14rpx; font-size: 22rpx; color: var(--text-2); }
.field-label { display: block; font-size: 24rpx; color: var(--text-2); margin: 22rpx 0 12rpx; }
input, textarea { width: 100%; box-sizing: border-box; background: var(--surface-2); padding: 18rpx; border-radius: 12rpx; font-size: 26rpx; color: var(--text-1); }
input { height: 78rpx; } textarea { height: 126rpx; }
.enabled-field { margin: 18rpx 0; font-size: 25rpx; color: var(--text-2); }
.preview-label { font-size: 20rpx; color: var(--text-3); margin-top: 12rpx; }
.text-preview { padding: 18rpx; background: var(--surface-2); border-radius: 12rpx; margin-top: 12rpx; text-align: center; }
.preview-top { display: block; font-size: 26rpx; color: var(--text-1); font-weight: 600; }
.preview-bottom { display: block; margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; color: var(--text-3); }
.editor-actions { margin: 24rpx 0 12rpx; } .editor-actions .action { flex: 1; padding: 22rpx; }
.egg-admin-page { min-height: 100vh; padding: 24rpx 32rpx; box-sizing: border-box; background: var(--gradient-open); }
.page-heading { font-size: 34rpx; font-weight: 600; margin: 16rpx 0; }.page-heading .action { min-height: 88rpx; }
.entry-card { border-radius: var(--radius-lg); padding: 28rpx; gap: 22rpx; box-shadow: var(--shadow-sm); }.entry-photo { width: 128rpx; height: 128rpx; border-radius: var(--radius-md); }.entry-title { font-size: 30rpx; }.entry-caption { font-size: 24rpx; color: var(--text-2); }.entry-actions { flex-wrap: wrap; gap: 4rpx; }.entry-actions .action { background: transparent; min-height: 88rpx; font-size: 24rpx; padding: 0 14rpx; }
.editor-mask { align-items: flex-end; padding: 0; animation: admin-mask-in 240ms ease both; }.editor-card { max-height: 82vh; border-radius: 36rpx 36rpx 0 0; padding: 34rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); animation: admin-drawer-in 280ms ease both; }.editor-mask.drawer-closing { animation: admin-mask-out 300ms ease both; pointer-events: none; }.drawer-closing .editor-card { animation: admin-drawer-out 300ms cubic-bezier(.4,0,.7,.3) both; }.editor-heading view { min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; }.photo-options > view { min-height: 88rpx; display: flex; align-items: center; }.action { min-height: 88rpx; }
@media (prefers-reduced-motion: reduce) { .editor-mask,.editor-card,.editor-mask.drawer-closing,.drawer-closing .editor-card { animation-duration: 1ms; } }
.entry-info { min-width: 0; }.entry-heading { flex-wrap: wrap; gap: 10rpx; }.entry-title { flex: 1 1 180rpx; line-height: 1.6; color: var(--text-1); }.entry-status { padding: 6rpx 12rpx; font-size: 22rpx; line-height: 1.5; }.page-heading .action { background: var(--accent-weak); color: var(--accent); font-size: 26rpx; padding: 18rpx 20rpx; }.photo-options { gap: 20rpx; flex-wrap: wrap; font-size: 24rpx; }.editor-heading { min-height: 88rpx; }.editor-heading > text { flex: 1; }.editor-actions .primary { color: var(--on-accent); background: var(--accent); font-weight: 600; }.enabled-field { min-height: 88rpx; }.field-label { font-size: 26rpx; line-height: 1.6; }.entry-actions .action:first-child { color: var(--accent); background: var(--accent-weak); font-weight: 550; }
/* 仅一个原生scroll-view滚动；外壳裁切，标题和保存区不参与滚动。 */
.editor-mask > .egg-editor-shell { display: flex; flex-direction: column; height: 82vh; max-height: 82vh; padding: 44rpx 0 0; overflow: hidden; }
.egg-editor-heading { display: flex; align-items: center; gap: 20rpx; flex: none; height: 88rpx; padding: 0 32rpx; box-sizing: border-box; font-size: 38rpx; font-weight: 650; color: var(--text-1); }.egg-editor-heading > text { flex: 1; min-width: 0; }.egg-editor-close { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0 -18rpx 0 0; padding: 0; background: transparent; border-radius: var(--radius-md); }.egg-editor-close image { width: 36rpx; height: 36rpx; }
.egg-editor-scroll { flex: 1; min-height: 0; height: 0; width: 100%; }.egg-editor-body { padding: 16rpx 32rpx 24rpx; box-sizing: border-box; }.egg-edit-hint { display: block; font-size: 24rpx; color: var(--text-3); line-height: 1.7; margin-bottom: 20rpx; }
.egg-editor-stage { text-align: center; padding: 8rpx 0; }.egg-title-editor,.egg-description-editor { display: block; width: 100%; height: auto; box-sizing: border-box; padding: 12rpx 10rpx; border: none; border-radius: var(--radius-md); background: transparent; color: var(--text-1); text-align: center; line-height: 1.7; }.egg-title-editor { font-size: 34rpx; font-weight: 600; min-height: 82rpx; margin-bottom: 20rpx; }.egg-title-placeholder { color: var(--text-2); }.egg-description-editor { color: var(--text-2); font-size: 27rpx; min-height: 88rpx; margin-top: 12rpx; }
.egg-stage-photo { width: 100%; height: 400rpx; overflow: hidden; border-radius: var(--radius-md); background: var(--surface-2); display: flex; align-items: center; justify-content: center; color: var(--text-3); font-size: 26rpx; }.egg-stage-photo image { display: block; width: 100%; height: 100%; }.egg-photo-hint { display: block; margin-top: 12rpx; color: var(--text-3); font-size: 22rpx; line-height: 1.7; }.egg-replace-photo { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 20rpx 0 0; padding: 18rpx 20rpx; border-radius: var(--radius-md); background: var(--accent-weak); color: var(--accent); font-size: 27rpx; line-height: 1.5; }.egg-editor-body .enabled-field { border-top: 1rpx solid var(--line); padding-top: 16rpx; margin-bottom: 0; }
.egg-editor-footer { flex: none; display: flex; align-items: stretch; gap: 20rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: var(--surface); }.egg-editor-footer button { flex: 1; margin: 0; min-height: 96rpx; padding: 20rpx 16rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-lg); font-size: 29rpx; line-height: 1.5; }.egg-cancel { background: var(--surface-2); color: var(--text-2); }.egg-save { background: var(--accent); color: var(--on-accent); font-weight: 600; }
