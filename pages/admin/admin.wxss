/* pages/admin/admin.wxss */
page { background: #f0f2f5; }
.container {
  width: 100%;
  min-height: 100vh;
  height: auto;
  display: block;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 顶部返回 */
.logout-bar { display: flex; justify-content: center; width: 100%; margin-bottom: 16rpx; box-sizing: border-box; }
.btn-logout { font-size: 24rpx; color: #e53e3e; padding: 8rpx 20rpx; background: #ffebee; border-radius: 20rpx; }

/* 通知订阅 */
.notify-bar { display: flex; width: 100%; margin-bottom: 16rpx; box-sizing: border-box; }
.notify-status {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 28rpx; border-radius: 16rpx; font-size: 26rpx;
  flex: 1; width: 100%; box-sizing: border-box;
}
.notify-status.on { background: #e8f5e9; color: #2e7d32; }
.notify-status.off { background: #fff3e0; color: #e65100; }
.notify-hint { font-size: 22rpx; color: #66bb6a; }
.notify-btn { font-size: 26rpx; color: #ff6d00; font-weight: bold; padding: 8rpx 24rpx; background: #fff; border-radius: 20rpx; }

/* 审核须知卡片 */
.notice-card {
  background: linear-gradient(135deg, #fff8e1, #fff3cd);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(133, 100, 4, 0.08);
}
.notice-title { font-size: 28rpx; font-weight: bold; color: #856404; display: block; margin-bottom: 16rpx; }
.notice-item { display: flex; align-items: flex-start; margin-bottom: 10rpx; }
.notice-item:last-child { margin-bottom: 0; }
.notice-dot { color: #856404; margin-right: 12rpx; flex-shrink: 0; font-size: 26rpx; }
.notice-text { font-size: 24rpx; color: #856404; flex: 1; line-height: 1.5; }

/* 选项卡 */
.tab-scroll { width: 100%; margin-bottom: 24rpx; white-space: nowrap; box-sizing: border-box; }
.tab-bar { display: inline-flex; gap: 12rpx; min-width: 100%; padding-bottom: 2rpx; box-sizing: border-box; }
.tab-item {
  flex: 1 0 160rpx; min-width: 160rpx; text-align: center; padding: 18rpx 20rpx;
  background: #fff; border-radius: 16rpx;
  font-size: 26rpx; color: #888; font-weight: 500;
  min-width: 0; box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}
.tab-item.active {
  background: linear-gradient(135deg, #1976d2, #1565c0);
  color: #fff; font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(25, 118, 210, 0.3);
}

/* 每个选项卡占满容器，避免继承全局居中布局后按内容收缩 */
.tab-panel { width: 100%; box-sizing: border-box; }

/* 通用标题区 */
.header { display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 24rpx; padding: 0 8rpx; box-sizing: border-box; }
.title { font-size: 36rpx; font-weight: bold; color: #333; }
.week-tag { background: #e3f2fd; color: #1976d2; padding: 8rpx 20rpx; border-radius: 20rpx; font-size: 24rpx; }

/* ========== 列表审核 ========== */

.playlist-card {
  background: #fff; border-radius: 24rpx; padding: 32rpx;
  width: 100%; box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.day-section { margin-bottom: 44rpx; }
.day-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20rpx; padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.day-title { font-size: 32rpx; font-weight: bold; color: #333; }
.day-actions { display: flex; align-items: center; gap: 16rpx; }
.day-count { color: #bbb; font-size: 24rpx; }
.btn-skip-day {
  color: #e53e3e; font-size: 24rpx;
  padding: 8rpx 20rpx; background: #fff5f5;
  border-radius: 20rpx; border: 1rpx solid #ffe0e0;
}

.song-list {}
.song-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 0; border-bottom: 1rpx dashed #eee;
}
.song-item:last-child { border-bottom: none; }
.song-name { font-size: 30rpx; color: #333; display: block; }
.song-singer { font-size: 24rpx; color: #888; margin-top: 6rpx; display: block; }
.copy-hint { font-size: 20rpx; color: #ccc; flex-shrink: 0; margin-left: 10rpx; }
.copy-tip-bar { font-size: 24rpx; color: #999; text-align: center; padding: 16rpx 0; margin-bottom: 20rpx; }
.btn-exception {
  background: #fff3e0; color: #f57c00; border: none;
  font-size: 22rpx; padding: 10rpx 24rpx; border-radius: 20rpx;
  margin: 0; flex-shrink: 0;
}
.btn-note {
  background: #e3f2fd; color: #1976d2; border: none;
  font-size: 22rpx; padding: 10rpx 24rpx; border-radius: 20rpx;
  margin: 0; flex-shrink: 0;
}
.song-actions { display: flex; gap: 12rpx; flex-shrink: 0; margin-left: 10rpx; }

/* 备注弹窗输入框 */
.note-modal-input {
  background: #f8f9fa; padding: 24rpx; border-radius: 16rpx;
  font-size: 28rpx; min-height: 80rpx; margin-bottom: 32rpx;
  border: 1rpx solid #eee; width: 100%; box-sizing: border-box;
}

.note-section { margin-top: 40rpx; padding-top: 24rpx; border-top: 2rpx solid #f0f0f0; }
.note-section .label { font-size: 26rpx; color: #555; font-weight: 500; }
.note-input {
  background: #f8f9fa; padding: 24rpx; border-radius: 16rpx;
  font-size: 28rpx; min-height: 100rpx; margin-top: 16rpx;
  border: 1rpx solid #eee;
}

.footer { margin-top: 50rpx; }
.btn-publish {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff; border-radius: 16rpx; font-size: 32rpx;
  height: 90rpx; line-height: 90rpx; font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.25);
}
.btn-publish[disabled] { background: #a5d6a7; box-shadow: none; }

.empty { text-align: center; margin-top: 200rpx; color: #bbb; font-size: 30rpx; }
.hint { display: block; font-size: 24rpx; color: #ccc; margin-top: 16rpx; }

/* 弹窗样式 */
.modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55); display: flex;
  align-items: center; justify-content: center; z-index: 100;
}
.modal-content { background: #fff; width: 85%; border-radius: 28rpx; padding: 44rpx; }
.modal-title { font-size: 34rpx; font-weight: bold; display: block; margin-bottom: 12rpx; color: #333; }
.modal-song { color: #666; font-size: 26rpx; display: block; margin-bottom: 32rpx; }

.reason-options { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.reason-tag { background: #f5f5f5; padding: 14rpx 28rpx; border-radius: 32rpx; font-size: 24rpx; }
.reason-tag.active { background: #e3f2fd; color: #1976d2; border: 1rpx solid #bbdefb; }
.reason-input { border-bottom: 2rpx solid #ddd; padding: 12rpx 0; margin-bottom: 32rpx; }

.modal-actions { display: flex; gap: 20rpx; }
.btn-cancel { flex: 1; background: #f5f5f5; color: #666; border: none; border-radius: 12rpx; font-size: 28rpx; }
.btn-delete-note { flex: 1; background: #ffebee; color: #e53e3e; border: none; border-radius: 12rpx; font-size: 26rpx; }
.btn-confirm { flex: 1; background: linear-gradient(135deg, #ff9800, #f57c00); color: #fff; border: none; border-radius: 12rpx; font-size: 28rpx; }

/* ========== 验证码管理 ========== */

/* 顶部操作按钮 */
.code-actions { display: flex; gap: 12rpx; }
.btn-generate {
  color: #1976d2; font-size: 24rpx; padding: 10rpx 24rpx;
  background: #e3f2fd; border-radius: 20rpx; font-weight: 500;
}
.btn-add {
  color: #07c160; font-size: 24rpx; padding: 10rpx 24rpx;
  background: #e8f5e9; border-radius: 20rpx; font-weight: 500;
}

/* 验证码列表 */
.code-card {
  background: transparent;
  width: 100%; box-sizing: border-box;
}
.code-item {
  background: #fff; border-radius: 20rpx; padding: 28rpx;
  margin-bottom: 20rpx;
  width: 100%; box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative; overflow: hidden;
}
.code-item::before {
  content: ''; position: absolute; top: 0; left: 0;
  width: 6rpx; height: 100%;
}
.code-item.published-item::before { background: #07c160; }
.code-item.draft-item::before { background: #ffc107; }

.code-main { display: flex; justify-content: space-between; align-items: flex-start; position: relative; }
.copy-tip { font-size: 20rpx; color: #ccc; align-self: flex-end; margin-top: 8rpx; }

/* 验证码大字体显示 */
.code-value {
  font-size: 48rpx; font-weight: 800;
  letter-spacing: 8rpx; font-family: 'Courier New', monospace;
  color: #333; line-height: 1.2;
}
.code-value.published { color: #07c160; }
.code-value.draft { color: #ccc; text-decoration: line-through; }

/* 状态标签 */
.code-status { margin-top: 8rpx; }
.status-tag { font-size: 22rpx; padding: 0; border-radius: 0; font-weight: 500; }
.tag-published { background: transparent; color: #07c160; }
.tag-draft { background: transparent; color: #f57c00; }

/* 元信息 */
.code-meta { display: flex; gap: 24rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx dashed #eee; }
.code-week { font-size: 22rpx; color: #aaa; }
.code-expire { font-size: 22rpx; color: #e53e3e; font-weight: 500; }

/* 操作按钮行 */
.code-actions-row { display: flex; gap: 12rpx; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.btn-edit-code {
  flex: 1; text-align: center; color: #1976d2; font-size: 24rpx;
  padding: 12rpx 0; background: #e3f2fd; border-radius: 12rpx; font-weight: 500;
}
.btn-publish-code {
  flex: 1.5; text-align: center; color: #fff; font-size: 24rpx;
  padding: 12rpx 0;
  background: linear-gradient(135deg, #07c160, #06ad56);
  border-radius: 12rpx; font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.2);
}
.btn-delete-code {
  flex: 1; text-align: center; color: #e53e3e; font-size: 24rpx;
  padding: 12rpx 0; background: #ffebee; border-radius: 12rpx; font-weight: 500;
}
.code-hint { font-size: 22rpx; color: #bbb; font-style: italic; margin-top: 16rpx; }

/* 验证码弹窗输入 */
.code-modal-input {
  background: #f8f9fa; padding: 28rpx; border-radius: 16rpx;
  font-size: 36rpx; text-align: center; letter-spacing: 12rpx;
  margin-bottom: 28rpx; border: 2rpx solid #eee; font-weight: bold;
  font-family: 'Courier New', monospace; color: #333;
}
.code-modal-input:focus { border-color: #1976d2; }

.date-inputs { margin-bottom: 28rpx; }
.date-field { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.date-label { font-size: 26rpx; color: #666; }
.date-picker {
  font-size: 26rpx; color: #1976d2; padding: 14rpx 28rpx;
  background: #e3f2fd; border-radius: 12rpx; font-weight: 500;
}

/* ========== 测试工具 ========== */

.test-section {
  background: #fff; border-radius: 20rpx; padding: 28rpx;
  width: 100%; box-sizing: border-box;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.test-section-title {
  font-size: 26rpx; color: #999; font-weight: 500;
  margin-bottom: 20rpx; padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 数据统计 */
.stats-row { display: flex; justify-content: space-between; }
.stat-item { text-align: center; flex: 1; }
.stat-num {
  display: block; font-size: 40rpx; font-weight: 800;
  color: #1976d2; line-height: 1.2;
}
.stat-label { display: block; font-size: 22rpx; color: #bbb; margin-top: 4rpx; }

/* 按钮网格 */
.test-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.test-btn {
  flex: 1; min-width: 200rpx; text-align: center;
  padding: 20rpx 0; border-radius: 12rpx;
  font-size: 26rpx; font-weight: 500; color: #fff;
}
.test-btn.blue { background: linear-gradient(135deg, #1976d2, #1565c0); }
.test-btn.green { background: linear-gradient(135deg, #07c160, #06ad56); }
.test-btn.orange { background: linear-gradient(135deg, #ff9800, #f57c00); }
.test-btn.red { background: linear-gradient(135deg, #e53e3e, #c62828); }
.test-btn.disabled { background: #bdbdbd; color: #f5f5f5; }
.test-safety-hint {
  display: block; margin-bottom: 20rpx; padding: 16rpx 20rpx;
  background: #e8f5e9; color: #2e7d32; border-radius: 12rpx;
  font-size: 22rpx; line-height: 1.5;
}

/* ========== 管理员管理 ========== */

.admin-section {
  background: #fff; border-radius: 20rpx; padding: 28rpx;
  width: 100%; box-sizing: border-box;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.admin-section-title {
  font-size: 26rpx; color: #999; font-weight: 500;
  margin-bottom: 20rpx; padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 通行码列表 */
.passcode-list {}
.passcode-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 0; border-bottom: 1rpx dashed #eee;
}
.passcode-item:last-child { border-bottom: none; }
.passcode-info { flex: 1; }
.passcode-label { font-size: 30rpx; color: #333; font-weight: 500; display: block; }
.passcode-preview {
  font-size: 26rpx; color: #1976d2; font-family: 'Courier New', monospace;
  letter-spacing: 4rpx; display: block; margin-top: 6rpx;
}
.passcode-date { font-size: 22rpx; color: #bbb; display: block; margin-top: 4rpx; }
.btn-delete-passcode {
  color: #e53e3e; font-size: 24rpx; padding: 10rpx 24rpx;
  background: #ffebee; border-radius: 12rpx; font-weight: 500; flex-shrink: 0;
}

/* 管理员列表 */
.admin-list {}
.admin-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 0; border-bottom: 1rpx dashed #eee;
}
.admin-item:last-child { border-bottom: none; }
.admin-info { flex: 1; display: flex; align-items: center; gap: 12rpx; }
.admin-openid {
  font-size: 24rpx; color: #666; font-family: 'Courier New', monospace;
}
.admin-role-tag {
  font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; font-weight: 500;
}
.role-super { background: #fce4ec; color: #c62828; }
.role-admin { background: #e3f2fd; color: #1976d2; }
.admin-date { font-size: 22rpx; color: #bbb; }
.btn-revoke {
  color: #e53e3e; font-size: 24rpx; padding: 10rpx 24rpx;
  background: #ffebee; border-radius: 12rpx; font-weight: 500; flex-shrink: 0;
}

/* 空状态 */
.admin-empty { text-align: center; padding: 40rpx 0; color: #ccc; font-size: 26rpx; }

/* 操作栏 */
.admin-action-bar { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.btn-add-passcode {
  background: linear-gradient(135deg, #1976d2, #1565c0);
  color: #fff; border: none; border-radius: 12rpx;
  font-size: 26rpx; font-weight: 500; padding: 16rpx 40rpx;
}

/* ========== 使用说明管理 ========== */

.btn-add-help {
  flex-shrink: 0; padding: 10rpx 22rpx; border-radius: 20rpx;
  background: #e8f5e9; color: #07c160; font-size: 24rpx; font-weight: 600;
}
.help-manage-hint {
  margin-bottom: 20rpx; padding: 18rpx 22rpx; border-radius: 14rpx;
  background: #fff8e1; color: #856404; font-size: 23rpx; line-height: 1.55;
}
.help-manage-loading {
  padding: 80rpx 0; color: #aaa; text-align: center; font-size: 26rpx;
}
.help-manage-item {
  margin-bottom: 20rpx; padding: 28rpx; border-radius: 20rpx;
  background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.help-manage-title-row { display: flex; align-items: center; gap: 14rpx; }
.help-manage-title {
  flex: 1; min-width: 0; color: #333; font-size: 30rpx; font-weight: 650;
}
.help-status {
  flex-shrink: 0; padding: 5rpx 12rpx; border-radius: 10rpx; font-size: 20rpx;
}
.help-status.published { background: #e8f5e9; color: #07c160; }
.help-status.draft { background: #fff3e0; color: #f57c00; }
.help-manage-summary {
  display: block; margin-top: 10rpx; color: #888; font-size: 24rpx; line-height: 1.5;
}
.help-image-count { display: block; margin-top: 10rpx; color: #bbb; font-size: 22rpx; }
.help-manage-actions {
  display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; padding-top: 18rpx;
  border-top: 1rpx solid #f0f0f0;
}
.help-action {
  padding: 10rpx 18rpx; border-radius: 10rpx; background: #f2f4f6;
  color: #666; font-size: 23rpx;
}
.help-action.edit { background: #e3f2fd; color: #1976d2; }
.help-action.delete { background: #ffebee; color: #e53e3e; }
.help-empty-text { display: block; margin-bottom: 22rpx; }
.btn-init-help {
  border: none; border-radius: 12rpx; background: #e8f5e9;
  color: #07c160; font-size: 25rpx; font-weight: 600;
}

/* 通行码结果弹窗 */
.passcode-result {
  text-align: center; padding: 32rpx 0; margin: 20rpx 0;
  background: #f8f9fa; border-radius: 16rpx;
}
.passcode-result-code {
  font-size: 56rpx; font-weight: 800; color: #1976d2;
  letter-spacing: 12rpx; font-family: 'Courier New', monospace;
  display: block;
}
.passcode-result-hint {
  font-size: 24rpx; color: #999; display: block;
  margin-top: 20rpx; text-align: center; line-height: 1.6;
}
