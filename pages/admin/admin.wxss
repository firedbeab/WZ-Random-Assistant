@media (max-width: 360px) { .container { padding-left: 24rpx; padding-right: 24rpx; }.audit-period-row { gap: 12rpx; }.audit-period-row .audit-period { font-size: 22rpx; }.audit-period-row .audit-period text { display: block; margin: 0; font-size: 25rpx; }.batch-entry { font-size: 24rpx; } }
.tips-button { background: transparent; box-shadow: none; color: var(--text-2); padding-left: 4rpx; font-weight: 500; }.audit-tools { margin-bottom: 0; min-height: 76rpx; }.notice-card { background: transparent; color: var(--text-2); padding: 8rpx 16rpx; border-left: 3rpx solid var(--line); border-radius: 0; margin: 0 4rpx 18rpx; }
.help-manage-item { padding: 22rpx 26rpx 14rpx; margin-bottom: 16rpx; }.help-manage-title { font-size: 30rpx; }.help-manage-summary { margin-top: 6rpx; font-size: 24rpx; line-height: 1.6; }.help-manage-actions { margin-top: 14rpx; padding-top: 8rpx; gap: 0 6rpx; }.help-action { min-height: 72rpx; padding: 0 10rpx; font-size: 24rpx; }.help-action.edit { min-width: 76rpx; padding: 0 14rpx; min-height: 64rpx; margin: 4rpx 0; border-radius: 10rpx; }.help-image-count { margin-top: 6rpx; font-size: 22rpx; }.help-manage-hint { font-size: 23rpx; margin-bottom: 18rpx; }
.code-input-wrap { position: relative; width: 100%; margin-bottom: 24rpx; height: 100rpx; }.code-input-wrap .code-modal-input { width: 100%; height: 100rpx; min-height: 100rpx; line-height: 100rpx; padding: 0 22rpx; margin: 0; }.code-placeholder { position: absolute; z-index: 1; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--placeholder); font-family: inherit; font-size: 28rpx; letter-spacing: normal; font-weight: 400; pointer-events: none; }.reason-input,.code-modal-input.label-input { height: 96rpx; min-height: 96rpx; line-height: 96rpx; padding: 0 22rpx; }
.help-action { min-height: 88rpx; }.help-action.edit { min-height: 88rpx; margin: 0; padding: 0; background: transparent; }.compact-action-label { display: inline-flex; align-items: center; justify-content: center; min-height: 64rpx; padding: 0 18rpx; border-radius: 10rpx; background: var(--accent-weak); color: var(--accent); }
.period-copy-hint { flex: none; font-size: 22rpx; color: var(--text-3); line-height: 1.7; }.audit-period-row { min-height: 56rpx; margin-top: 0; }.bottom-buttons { display: flex; gap: 14rpx; align-items: stretch; flex: none; }.bottom-buttons .batch-entry { font-size: 24rpx; min-height: 88rpx; padding: 16rpx 18rpx; }.bottom-buttons .btn-publish,.bottom-buttons .btn-remove-selected { font-size: 27rpx; min-height: 88rpx; padding: 16rpx 22rpx; }.audit-bottom { gap: 16rpx; }.bottom-copy { min-width: 0; font-size: 26rpx; }.bottom-hint { font-size: 21rpx; line-height: 1.5; }
.bottom-buttons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); flex: 1; max-width: 440rpx; min-width: 0; gap: 16rpx; }
.bottom-buttons > .batch-entry,.bottom-buttons > .btn-publish,.bottom-buttons > .btn-remove-selected { width: 100%; min-width: 0; min-height: 92rpx; margin: 0; padding: 16rpx 12rpx; border-radius: var(--radius-lg); font-size: 28rpx; line-height: 1.5; font-weight: 600; }
.bottom-copy { flex: none; width: 160rpx; }.bottom-copy > text { display: block; }.batch-error { display: block; color: var(--danger); font-size: 24rpx; line-height: 1.7; margin-bottom: 18rpx; }
.date-field-trigger { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; min-height: 96rpx; margin: 0; padding: 20rpx 24rpx; box-sizing: border-box; border-radius: var(--radius-md); background: var(--surface-2); color: var(--text-1); font-size: 28rpx; line-height: 1.6; text-align: left; }
.date-field-trigger .date-label { color: var(--text-2); font-size: 26rpx; }.date-field-value { display: flex; align-items: center; gap: 12rpx; min-width: 0; font-variant-numeric: tabular-nums; }.date-field-value.is-placeholder { color: var(--text-3); }.date-field-value image { width: 28rpx; height: 28rpx; flex: none; }

page { background:var(--gradient-page); }.container { background:transparent; min-height:calc(var(--window-height, 100vh) - var(--navigation-height, 64px)); }
