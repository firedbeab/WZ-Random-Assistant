<page-meta page-style="{{appearanceStyle}}" />
<view class="container" bindtouchstart="onAdminTouchStart" bindtouchmove="onAdminTouchMove" bindtouchend="onAdminTouchEnd" bindtouchcancel="onAdminTouchCancel">
  <view class="admin-hero">
    <view class="admin-heading"><text class="admin-title">管理后台</text><button class="notify-button" wx:if="{{!subscribed}}" bindtap="onEnableNotification" aria-label="开启审核通知"><image src="{{themeIcons.bellMuted}}" /></button><view class="notify-button notify-enabled" wx:else aria-label="已开启审核通知"><image src="{{themeIcons.bell}}" /><view class="notify-dot" /></view></view>
    <view class="admin-meta"><text class="environment-tag" wx:if="{{isTestMode}}">测试模式</text><appearance-toggle /></view>
  </view>
  <view class="tab-bar" wx:if="{{currentTab === 'audit' || currentTab === 'codes' || currentTab === 'test' || currentTab === 'manage'}}">
    <view class="tab-item {{currentTab === 'audit' ? 'active' : ''}}" bindtap="switchTab" data-tab="audit">审核</view>
    <view class="tab-item {{currentTab === 'codes' ? 'active' : ''}}" bindtap="switchTab" data-tab="codes">验证码</view>
    <view class="tab-item {{currentTab === 'test' ? 'active' : ''}}" bindtap="switchTab" data-tab="test" wx:if="{{isTestEnv}}">控制台</view>
    <view class="tab-item {{currentTab === 'manage' ? 'active' : ''}}" bindtap="switchTab" data-tab="manage" wx:if="{{isSuperAdmin}}">管理</view>
    <view class="tab-indicator" style="width: {{100 / (isSuperAdmin ? 4 : isTestEnv ? 3 : 2)}}%; left: {{(currentTab === 'audit' ? 0 : currentTab === 'codes' ? 1 : currentTab === 'test' ? 2 : 3) * 100 / (isSuperAdmin ? 4 : isTestEnv ? 3 : 2)}}%;"><view class="indicator-line" /></view>
  </view>
  <view class="sub-heading" wx:else><button class="sub-back" bindtap="switchTab" data-tab="manage" aria-label="返回管理"><image src="{{themeIcons.back}}" /></button><text>{{currentTab === 'admins' ? '管理员与通行码' : currentTab === 'help' ? '说明管理' : '数据管理'}}</text><button class="new-entry-button" wx:if="{{currentTab === 'help'}}" bindtap="onAddHelpArticle">＋ 新建</button></view>
  <view class="panel-stage {{panelVisible ? 'panel-visible' : ''}}">
  <view class="tab-panel" wx:if="{{currentTab === 'audit'}}">
    <view class="audit-tools"><button class="tips-button {{showAuditTips ? 'expanded' : ''}}" bindtap="toggleAuditTips" aria-expanded="{{showAuditTips}}"><text>审核要点</text><image src="{{themeIcons.chevron}}" /></button></view>
    <view class="notice-expand {{showAuditTips ? 'expanded' : ''}}"><view class="notice-inner"><view class="notice-card"><text>检查重复曲目、可播放性及名称内容。异常处理会尝试替补；标记移除不补位，发布前可撤销。</text></view></view></view>
    <view class="audit-period-row" wx:if="{{schedule}}"><view class="audit-period">排期周次 <text>{{scheduleWeekKey}}</text></view><text class="period-copy-hint">长按复制歌曲信息</text></view><text class="batch-hint" wx:if="{{batchResultMessage}}">{{batchResultMessage}}</text>
    <view class="week-warning" wx:if="{{schedule && !scheduleIsCurrentWeek}}">这是 {{scheduleWeekKey}} 的排期，不是本周（{{thisWeekKey}}），发布前请确认。</view>
    <view class="week-warning" wx:if="{{schedule && schedule.carryover_only}}">本周没有新投稿，曲目全部来自历史候补。</view>
    <view class="state-message" wx:if="{{auditLoading && !schedule}}"><text>正在加载排期</text><text class="hint">请稍候。</text></view>
    <view class="state-message" wx:elif="{{auditError}}"><text>排期加载失败</text><text class="hint">{{auditError}}</text><button class="text-button" bindtap="retryPlaylist">重新加载</button></view>
    <block wx:elif="{{schedule}}">
      <view class="playlist-card">
        <block wx:for="{{['周一','周二','周三','周四','周五']}}" wx:key="*this" wx:for-index="dayIdx">
          <view class="day-section">
            <view class="day-header"><text class="day-title">{{item}}</text><text class="day-count">{{dayCounts[dayIdx].active}} 首<text wx:if="{{dayCounts[dayIdx].pending}}"> · {{dayCounts[dayIdx].pending}} 待移除</text></text><button class="text-button" bindtap="onSkipDay" data-day="{{dayIdx}}" disabled="{{!dayCounts[dayIdx].active && !dayCounts[dayIdx].pending}}">跳过</button></view>
            <view class="audit-song-list">
              <view class="song-item {{item.audit_state === 'pending_remove' ? 'pending-remove' : ''}}" wx:for="{{schedule['day'+(dayIdx+1)]}}" wx:key="submission_id" wx:for-index="songIdx">
                <button class="check-hit" wx:if="{{batchMode && item.audit_state !== 'pending_remove'}}" bindtap="toggleAuditSong" data-day="{{dayIdx}}" data-song-index="{{songIdx}}" aria-role="checkbox" aria-checked="{{!!auditChecked['day'+dayIdx][songIdx]}}" aria-label="选择{{item.song_name}}"><view class="selection-box {{auditChecked['day'+dayIdx][songIdx] ? 'checked' : ''}}"><view class="check-mark" wx:if="{{auditChecked['day'+dayIdx][songIdx]}}" /></view></button>
                <text class="song-index" wx:else>{{songIdx + 1}}</text>
                <view class="song-info" bindlongpress="onCopySong" data-name="{{item.song_name}}" data-singer="{{item.singer}}" data-note="{{item.special_note}}"><view class="song-line"><text class="song-name">{{item.song_name}}</text><text class="song-singer">{{item.singer}}</text></view><text class="song-special" wx:if="{{item.special_note}}">{{item.special_note}}</text><text class="pending-remove-note" wx:if="{{item.audit_state === 'pending_remove'}}">待移除 · {{item.removal_reason || '当天安排调整'}}</text></view>
                <button class="text-button restore-button" wx:if="{{item.audit_state === 'pending_remove'}}" bindtap="onRestoreRemoval" data-day="{{dayIdx}}" data-song-index="{{songIdx}}">撤销</button>
                <button class="more-button" wx:else bindtap="openSongActions" data-day="{{dayIdx}}" data-song-index="{{songIdx}}" data-song="{{item}}" aria-label="{{item.song_name}}的操作"><view /><view /><view /></button>
              </view>
            </view>
            <text class="empty-day" wx:if="{{!schedule['day'+(dayIdx+1)].length}}">当天没有曲目安排</text>
          </view>
        </block>
      </view>
      <view class="audit-bottom"><view class="bottom-copy"><text>{{batchMode ? '已选 '+batchSelectedCount+' 首' : activeSongCount+' 首 · 5 天'}}</text><text class="bottom-hint">{{batchMode ? '不补位，发布前可撤销' : pendingRemovalCount ? pendingRemovalCount+' 首待移除' : '核对后向用户发布'}}</text></view><view class="bottom-buttons"><button class="batch-entry" bindtap="openBatchRemoval" disabled="{{batchRemoving || publishing}}">{{batchMode ? '取消移除' : '批量移除'}}</button><button class="btn-remove-selected" wx:if="{{batchMode}}" bindtap="openBulkConfirm" disabled="{{!batchSelectedCount || batchRemoving}}">移除 {{batchSelectedCount}} 首</button><button class="btn-publish" wx:else bindtap="onPublish" disabled="{{publishing}}">发布歌单</button></view></view>
    </block>
    <view class="state-message" wx:else><text>暂无待审核排期</text><text class="hint">请等待周日 20:00 自动抽取。</text></view>
  </view>
  <view class="tab-panel" wx:elif="{{currentTab === 'codes'}}">
    <view class="audit-tools"><text>发布后不可修改或删除</text><view class="code-actions"><button class="text-button accent" bindtap="onGenerateCode">自动生成</button><button class="text-button accent" bindtap="onAddCode">添加</button></view></view>
    <view class="code-card" wx:if="{{codeList.length}}"><view class="code-item" wx:for="{{codeList}}" wx:key="_id"><view class="code-top"><text class="code-value" bindlongpress="onCopyCode" data-code="{{item.code}}">{{item.code}}</text><text class="status-tag {{item.is_published ? 'tag-published' : ''}}">{{item.is_published ? '已发布' : '草稿'}}</text></view><view class="code-meta"><text>有效至 {{item.expire_date}}</text><text>长按复制</text></view><view class="code-actions-row" wx:if="{{!item.is_published}}"><button class="text-button" bindtap="onEditCode" data-id="{{item._id}}" data-code="{{item.code}}">编辑</button><button class="text-button danger-text" bindtap="onDeleteCode" data-id="{{item._id}}">删除</button><button class="small-primary" bindtap="onPublishCode" data-id="{{item._id}}">发布</button></view></view></view><view class="state-message" wx:else><text>暂无验证码</text><text class="hint">自动生成或手动添加当周验证码。</text></view>
  </view>
  <view class="tab-panel" wx:elif="{{currentTab === 'test'}}">
    <view class="test-section channel-section"><view class="section-heading"><text>点歌通道</text><button class="text-button" bindtap="loadChannelStatus" disabled="{{channelBusy || channelLoading}}">刷新</button></view><text class="channel-current">{{channelLoading ? '正在读取状态…' : channelMode === 'open' ? '强制开放中' : channelMode === 'close' ? '强制关闭中' : channelMode === 'normal' ? '按正常时间开放' : '状态读取失败'}}</text><text class="channel-hint">{{channelMode === 'normal' ? '每周日 8:00–20:00 自动开放' : channelMode === 'open' ? '当前忽略开放时段限制' : channelMode === 'close' ? '当前暂停接收点歌' : '请刷新后再调整，避免误判当前状态'}}</text><view class="channel-options"><button class="channel-option {{channelMode === 'normal' ? 'selected' : ''}}" bindtap="onToggleChannel" data-mode="reset" disabled="{{channelBusy || channelLoading || !channelMode}}">正常时间</button><button class="channel-option {{channelMode === 'open' ? 'selected' : ''}}" bindtap="onToggleChannel" data-mode="open" disabled="{{channelBusy || channelLoading || !channelMode}}">强制开放</button><button class="channel-option {{channelMode === 'close' ? 'selected' : ''}}" bindtap="onToggleChannel" data-mode="close" disabled="{{channelBusy || channelLoading || !channelMode}}">强制关闭</button></view><text class="channel-hint" wx:if="{{channelBusy}}">正在处理，请稍候…</text></view>
    <view class="test-section"><view class="section-heading"><text>数据统计</text><button class="text-button" bindtap="onTestStats">刷新</button></view><text class="section-hint">当前数据域总量；带箭头条目可进入查看与维护。</text><view class="stats-grid" wx:if="{{testStats}}"><view class="stat-item {{isSuperAdmin ? 'stat-link' : ''}}" bindtap="goConsoleDetail" data-mode="submissions" aria-role="button"><text class="stat-num">{{testStats.total.submissions}}</text><view class="stat-label"><text>投稿记录</text><image wx:if="{{isSuperAdmin}}" src="{{themeIcons.chevronRight}}" /></view></view><view class="stat-item {{isSuperAdmin ? 'stat-link' : ''}}" bindtap="goConsoleDetail" data-mode="schedules" aria-role="button"><text class="stat-num">{{testStats.total.schedules}}</text><view class="stat-label"><text>排期</text><image wx:if="{{isSuperAdmin}}" src="{{themeIcons.chevronRight}}" /></view></view><view class="stat-item stat-link" bindtap="switchTab" data-tab="codes" aria-role="button"><text class="stat-num">{{testStats.total.weekly_codes}}</text><view class="stat-label"><text>验证码</text><image src="{{themeIcons.chevronRight}}" /></view></view><view class="stat-item {{isSuperAdmin ? 'stat-link' : ''}}" bindtap="goConsoleDetail" data-mode="events" aria-role="button"><text class="stat-num">{{(testStats.total.schedule_exceptions || 0) + (testStats.total.system_events || 0)}}</text><view class="stat-label"><text>异常与事件</text><image wx:if="{{isSuperAdmin}}" src="{{themeIcons.chevronRight}}" /></view></view><view class="stat-item {{isSuperAdmin ? 'stat-link' : ''}}" bindtap="goConsoleDetail" data-mode="counters" aria-role="button"><text class="stat-num">{{testStats.total.submission_counters}}</text><view class="stat-label"><text>计数器</text><image wx:if="{{isSuperAdmin}}" src="{{themeIcons.chevronRight}}" /></view></view><view class="stat-item"><text class="stat-num">{{testStats.total.message_subscriptions}}</text><text class="stat-label">订阅记录</text></view><view class="stat-item"><text class="stat-num">{{testStats.total.users}}</text><text class="stat-label">用户</text></view></view><text class="section-hint" wx:else>统计暂未读取成功，可点击刷新。</text></view>
    <block wx:if="{{isTestMode}}"><view class="test-section"><text class="section-heading">数据生成</text><view class="test-grid"><button bindtap="onTestGenerate" data-count="10">生成 10 条</button><button bindtap="onTestGenerate" data-count="50">生成 50 条</button><button bindtap="onTestGenerate" data-count="250">生成 250 条</button><button bindtap="onTestGenCodes">生成验证码</button><button bindtap="onTestGenPublished">生成已发布排期</button></view></view><view class="test-section"><text class="section-heading">流程模拟</text><view class="test-grid"><button bindtap="onTestDraw">一键抽取</button><button bindtap="onTestSimulateSubmitted">模拟已提交</button></view></view><view class="test-section"><text class="section-heading">数据清理</text><text class="section-hint">执行前核对影响范围并完成服务端二次确认。</text><view class="test-grid"><button class="danger-text" bindtap="onTestClearWeek">清空本周</button><button class="danger-text" bindtap="onTestClearSubscriptions">清空订阅</button><button class="danger-text" bindtap="onTestClearAll">清空全部测试数据</button></view></view></block>
  </view>
  <view class="tab-panel" wx:elif="{{currentTab === 'manage' && isSuperAdmin}}"><view class="entry-list"><button class="entry-row" bindtap="switchTab" data-tab="help"><view><text class="entry-title">说明管理</text><text class="entry-desc">内容、图片与展示顺序</text></view><image src="{{themeIcons.chevronRight}}" /></button><button class="entry-row" bindtap="goEasterEggs"><view><text class="entry-title">彩蛋管理</text><text class="entry-desc">照片、文案与启用状态</text></view><image src="{{themeIcons.chevronRight}}" /></button><button class="entry-row" bindtap="switchTab" data-tab="admins"><view><text class="entry-title">管理员与通行码</text><text class="entry-desc">管理身份和管理员通行码</text></view><image src="{{themeIcons.chevronRight}}" /></button></view></view>
<!-- ========== 管理员管理 ========== -->
<view class="tab-panel" wx:if="{{currentTab === 'admins'}}">


  <!-- 通行码管理 -->
  <view class="admin-section">
    <view class="admin-section-title">通行码管理</view>

    <view class="passcode-list" wx:if="{{passcodeList.length > 0}}">
      <view class="passcode-item" wx:for="{{passcodeList}}" wx:key="_id">
        <view class="passcode-info">
          <text class="passcode-label">{{item.label}}</text>
          <text class="passcode-preview">{{item.code_preview}}</text>
          <text class="passcode-date">{{item.created_at}}</text>
        </view>
        <text class="btn-delete-passcode" bindtap="onDeletePasscode" data-id="{{item._id}}" data-label="{{item.label}}">删除</text>
      </view>
    </view>

    <view class="admin-empty" wx:else>
      <text>暂无通行码</text>
    </view>

    <view class="admin-action-bar">
      <button class="btn-add-passcode" size="mini" bindtap="onAddPasscode">＋ 生成新通行码</button>
    </view>
  </view>

  <!-- 管理员列表 -->
  <view class="admin-section">
    <view class="admin-section-title">管理员列表</view>

    <view class="admin-list" wx:if="{{adminList.length > 0}}">
      <view class="admin-item" wx:for="{{adminList}}" wx:key="openid">
        <view class="admin-info">
          <text class="admin-openid">{{item.admin_label}}</text>
          <text class="admin-date">{{item.last_verify_date}}</text>
        </view>
        <view class="admin-side">
          <view class="admin-role-tag {{item.role === 'superadmin' ? 'role-super' : 'role-admin'}}"><text>{{item.role === 'superadmin' ? '超级管理员' : '管理员'}}</text></view>
          <view class="btn-revoke" wx:if="{{item.role !== 'superadmin'}}" bindtap="onRevokeAdmin" data-openid="{{item.openid}}"><text>撤销</text></view>
        </view>
      </view>
    </view>

    <view class="admin-empty" wx:else>
      <text>暂无管理员</text>
    </view>
  </view>
</view>

<!-- ========== 使用说明管理 ========== -->
<view class="tab-panel" wx:elif="{{currentTab === 'help'}}">


  <view class="help-manage-hint">用户端按这里的顺序展示。草稿和已隐藏条目不会对用户显示。</view>

  <view class="help-manage-loading" wx:if="{{helpLoading}}">加载中...</view>
  <view class="help-manage-list" wx:elif="{{helpArticleList.length > 0}}">
    <view class="help-manage-item" wx:for="{{helpArticleList}}" wx:key="_id">
      <view class="help-manage-main">
        <view class="help-manage-title-row">
          <text class="help-manage-title">{{item.title}}</text>
          <text class="help-status {{item.is_published ? 'published' : 'draft'}}">{{item.is_published ? '已发布' : '草稿'}}</text>
        </view>
        <text class="help-manage-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
        <text class="help-image-count" wx:if="{{item.images.length}}">{{item.images.length}} 张图片</text>
      </view>

      <view class="help-manage-actions">
        <text class="help-action" wx:if="{{index > 0}}" bindtap="onMoveHelpArticle" data-id="{{item._id}}" data-direction="up">上移</text>
        <text class="help-action" wx:if="{{index < helpArticleList.length - 1}}" bindtap="onMoveHelpArticle" data-id="{{item._id}}" data-direction="down">下移</text>
        <text class="help-action" bindtap="onToggleHelpArticle" data-id="{{item._id}}" data-published="{{item.is_published}}">{{item.is_published ? '隐藏' : '发布'}}</text>
        <text class="help-action edit" bindtap="onEditHelpArticle" data-id="{{item._id}}"><text class="compact-action-label">编辑</text></text>
        <text class="help-action delete" bindtap="onDeleteHelpArticle" data-id="{{item._id}}" data-title="{{item.title}}">删除</text>
      </view>
    </view>
  </view>

  <view class="admin-empty" wx:else>
    <text class="help-empty-text">暂无使用说明</text>
    <button class="btn-init-help" size="mini" bindtap="onInitializeHelpArticles">生成默认说明</button>
  </view>
</view>


  </view>
</view>
<!-- 异常处理弹窗 -->
<view class="modal admin-drawer-mask {{drawerClosing ? 'drawer-closing' : ''}}" wx:if="{{showModal}}" id="drawer-showModal" bindtap="onAdminDrawerMaskTap" data-close="closeModal">
  <view class="modal-content admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeModal"><view class="drawer-handle" data-drawer-drag="true" />
    <text class="modal-title" data-drawer-drag="true">标记异常项目</text>
    <text class="modal-song">《{{modalSong.song_name}}》- {{modalSong.singer}}</text>

    <view class="reason-options">
      <block wx:for="{{reasons}}" wx:key="index">
        <view class="reason-tag {{selectedReason === item ? 'active' : ''}}" bindtap="selectReason" data-reason="{{item}}">
          {{item}}
        </view>
      </block>
    </view>

    <input class="reason-input" placeholder="其他原因..." placeholder-class="form-placeholder" value="{{customReason}}" bindinput="onReasonInput"/>

    <view class="modal-actions">
      <button class="btn-cancel" bindtap="closeModal">取消</button>
      <button class="btn-confirm" bindtap="confirmException">确认处理</button>
    </view>
  </view>
</view>

<!-- 手动添加/编辑验证码弹窗 -->
<view class="modal admin-drawer-mask {{drawerClosing ? 'drawer-closing' : ''}}" wx:if="{{showCodeModal}}" id="drawer-showCodeModal" bindtap="onAdminDrawerMaskTap" data-close="closeCodeModal">
  <view class="modal-content admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeCodeModal"><view class="drawer-handle" data-drawer-drag="true" />
    <text class="modal-title" data-drawer-drag="true">{{editingCodeId ? '编辑验证码' : '添加验证码'}}</text>
    <view class="code-input-wrap"><text class="code-placeholder" wx:if="{{!newCode}}">输入6位验证码</text><input class="code-modal-input" placeholder="" value="{{newCode}}" bindinput="onNewCodeInput" maxlength="6" /></view>
    <view class="date-inputs">
      <view class="date-field">
        <text class="date-label">过期日期</text>
      <button class="date-picker" bindtap="openExpireDate">{{newExpireDate || '选择日期'}}</button>
      </view>
    </view>
    <view class="modal-actions">
      <button class="btn-cancel" bindtap="closeCodeModal">取消</button>
      <button class="btn-confirm" bindtap="confirmSaveCode">{{editingCodeId ? '保存' : '添加'}}</button>
    </view>
  </view>
</view>

<!-- 添加通行码弹窗 -->
<view class="modal admin-drawer-mask {{drawerClosing ? 'drawer-closing' : ''}}" wx:if="{{showPasscodeModal}}" id="drawer-showPasscodeModal" bindtap="onAdminDrawerMaskTap" data-close="closePasscodeModal">
  <view class="modal-content admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closePasscodeModal"><view class="drawer-handle" data-drawer-drag="true" />
    <text class="modal-title" data-drawer-drag="true">生成管理员通行码</text>
    <input class="code-modal-input label-input" placeholder="输入描述标签（如：张老师）" placeholder-class="form-placeholder" value="{{newPasscodeLabel}}" bindinput="onPasscodeLabelInput" maxlength="20"/>
    <view class="modal-actions">
      <button class="btn-cancel" bindtap="closePasscodeModal">取消</button>
      <button class="btn-confirm" bindtap="confirmAddPasscode">生成</button>
    </view>
  </view>
</view>

<!-- 显示通行码弹窗 -->
<view class="modal admin-drawer-mask {{drawerClosing ? 'drawer-closing' : ''}}" wx:if="{{showPasscodeResultModal}}" id="drawer-showPasscodeResultModal" bindtap="onAdminDrawerMaskTap" data-close="closePasscodeResultModal">
  <view class="modal-content admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closePasscodeResultModal"><view class="drawer-handle" data-drawer-drag="true" />
    <text class="modal-title" data-drawer-drag="true">通行码已生成</text>
    <view class="passcode-result">
      <text class="passcode-result-code" bindlongpress="onCopyPasscode">{{generatedPasscode}}</text>
      <text class="copy-tip">长按复制</text>
    </view>
    <text class="passcode-result-hint">请将此通行码发送给对应管理员\n通行码仅显示一次，关闭后无法找回</text>
    <view class="modal-actions">
      <button class="btn-confirm" bindtap="closePasscodeResultModal">我已保存，关闭</button>
    </view>
  </view>
</view>

<!-- 特殊备注编辑弹窗 -->
<view class="modal admin-drawer-mask {{drawerClosing ? 'drawer-closing' : ''}}" wx:if="{{showNoteModal}}" id="drawer-showNoteModal" bindtap="onAdminDrawerMaskTap" data-close="closeNoteModal">
  <form class="modal-content admin-drawer" bindsubmit="confirmSaveNote" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeNoteModal"><view class="drawer-handle" data-drawer-drag="true" />
    <text class="modal-title" data-drawer-drag="true">特殊备注</text>
    <text class="modal-song">《{{noteSong.song_name}}》- {{noteSong.singer}}</text>
    <textarea name="noteText" class="note-modal-input" placeholder="输入特殊备注（选填，如：要求特定版本）" placeholder-class="form-placeholder" value="{{noteText}}" bindinput="onNoteTextInput" maxlength="50" auto-height></textarea>
    <view class="modal-actions">
      <button class="btn-cancel" bindtap="closeNoteModal" disabled="{{noteSaving}}">取消</button>
      <button class="btn-delete-note" wx:if="{{noteSong.special_note}}" bindtap="deleteNote" disabled="{{noteSaving}}">删除备注</button>
      <button class="btn-confirm" form-type="submit" disabled="{{noteSaving}}">{{noteSaving ? '保存中...' : '保存'}}</button>
    </view>
  </form>
</view>



<view class="modal admin-drawer-mask {{drawerClosing ? 'drawer-closing' : ''}}" wx:if="{{showSongDrawer}}" id="drawer-showSongDrawer" bindtap="onAdminDrawerMaskTap" data-close="closeSongDrawer"><view class="modal-content admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeSongDrawer"><view class="drawer-handle" data-drawer-drag="true" /><view class="drawer-song-line"><text class="modal-title" data-drawer-drag="true">{{actionSong.song_name}}</text><text>{{actionSong.singer}}</text></view><text class="drawer-description" data-drawer-drag="true">{{['周一','周二','周三','周四','周五'][actionDay]}} · 第 {{actionSongIndex + 1}} 首</text><text class="drawer-note" wx:if="{{actionSong.special_note}}">{{actionSong.special_note}}</text><view class="drawer-menu"><button class="drawer-menu-row" bindtap="onSongDrawerAction" data-action="note"><text>{{actionSong.special_note ? '修改特殊备注' : '添加特殊备注'}}</text><text class="drawer-row-hint">{{actionSong.special_note ? '已有备注' : '选填'}}</text></button><button class="drawer-menu-row" bindtap="onSongDrawerAction" data-action="exception"><text>标记为异常并替补</text><text class="drawer-row-hint">尝试补一首</text></button><button class="drawer-menu-row danger-text" bindtap="onSongDrawerAction" data-action="remove"><text>从本期移除</text><text class="drawer-row-hint">不补位</text></button></view><view class="modal-actions"><button class="btn-cancel" bindtap="closeSongDrawer">关闭</button></view></view></view>
<view class="modal admin-drawer-mask {{drawerClosing ? 'drawer-closing' : ''}}" wx:if="{{showPublishDrawer}}" id="drawer-showPublishDrawer" bindtap="onAdminDrawerMaskTap" data-close="closePublishDrawer"><form class="modal-content admin-drawer" bindsubmit="confirmPublish" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closePublishDrawer"><view class="drawer-handle" data-drawer-drag="true" /><text class="modal-title" data-drawer-drag="true">发布本期歌单</text><text class="drawer-description" data-drawer-drag="true">{{scheduleWeekKey}} 期 · 请核对曲目与日期</text><view class="publish-summary"><view><text>曲目</text><text>{{activeSongCount}} 首</text></view><view><text>播出天数</text><text>{{publishDayCount}} 天</text></view><view><text>待移除</text><text>{{pendingRemovalCount}} 首</text></view></view><text class="drawer-description" data-drawer-drag="true">发布后向用户展示歌单，待移除曲目将最终移除；已发送的通知无法撤回。</text><text class="field-label publish-label">说明备注（{{activeSongCount ? '选填' : '必填'}}，会显示在用户端）</text><view class="drawer-input-wrap {{publishNoteFocused ? 'focused' : ''}}"><textarea name="publishNote" class="note-input" value="{{note}}" bindinput="onNoteInput" bindfocus="onPublishNoteFocus" bindblur="onPublishNoteBlur" maxlength="100" placeholder="例：周三因活动调整顺序…" placeholder-class="form-placeholder" disabled="{{publishing}}" /></view><text class="drawer-error" wx:if="{{publishError}}">{{publishError}}</text><view class="modal-actions"><button class="btn-cancel" bindtap="closePublishDrawer" disabled="{{publishing}}">再看看</button><button class="btn-confirm" form-type="submit" disabled="{{publishing || (!activeSongCount && !publishNoteValid)}}" loading="{{publishing}}">{{publishing ? '发布中…' : '确认发布'}}</button></view></form></view>

<view class="modal admin-drawer-mask {{drawerClosing ? 'drawer-closing' : ''}}" wx:if="{{showBulkConfirmDrawer}}" id="drawer-showBulkConfirmDrawer" bindtap="onAdminDrawerMaskTap" data-close="closeBulkConfirm"><form class="modal-content admin-drawer" bindsubmit="confirmBulkRemoval" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeBulkConfirm"><view class="drawer-handle" data-drawer-drag="true" /><text class="modal-title" data-drawer-drag="true">标记移除所选曲目</text><text class="drawer-description" data-drawer-drag="true">不自动补位，发布前可以逐首撤销。发布时才会最终移除。</text><view class="publish-summary"><view wx:for="{{bulkConfirmDays}}" wx:key="day"><text>{{item.day}}</text><text>{{item.count}} 首</text></view></view><text class="field-label">调整原因（选填）</text><input class="reason-input" name="removalReason" maxlength="100" placeholder="例：当天活动调整" placeholder-class="form-placeholder" disabled="{{batchRemoving}}" /><view class="modal-actions"><button class="btn-cancel" bindtap="closeBulkConfirm" disabled="{{batchRemoving}}">再看看</button><button class="btn-remove-selected" form-type="submit" disabled="{{batchRemoving}}">{{batchRemoving ? '处理中…' : '确认移除'}}</button></view></form></view>
<!-- 隐私协议弹窗 -->
<privacy-popup id="privacyPopup"></privacy-popup>

<include src="../../templates/admin-feedback.wxml" />
