/* 首页：公共变量 + 状态、主操作、辅助入口三级层次。 */
page { background: var(--bg); color: var(--text-1); font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif; }
.home-page { min-height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; }
.num { font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1; }
button { margin: 0; padding: 0; border: none; border-radius: 0; font-weight: 400; }
button::after { border: none; }
.text-button { display: inline-block; background: transparent; color: var(--text-2); font-size: var(--font-sm); line-height: 1.5; padding: var(--space-2) 0; }
.text-pressed { opacity: .6; }
.test-banner { padding: var(--space-2) var(--space-4); background: var(--warn-weak); color: var(--warn); font-size: var(--font-xs); text-align: center; line-height: 1.5; }
.home-head { padding: var(--space-5) var(--space-5) var(--space-6); background: var(--gradient-closed); }
.home-head.is-open { background: var(--gradient-open); }
.brand-row { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); }
.brand { display: flex; align-items: center; min-width: 0; }
.dice { display: inline-block; font-size: var(--font-lg); padding: var(--space-2); margin: calc(var(--space-2) * -1); line-height: 1; flex: none; }
.dice:active { transform: rotate(-12deg) scale(.92); }
.brand-name { margin-left: var(--space-2); font-size: var(--font-md); font-weight: 500; }
.admin-link { flex: none; }
.status-row { display: flex; align-items: center; flex-wrap: wrap; margin-top: var(--space-5); color: var(--text-2); font-size: var(--font-sm); line-height: 1.6; }
.status-dot { flex: none; width: var(--space-1); height: var(--space-1); margin-right: var(--space-2); border-radius: var(--radius-pill); background: var(--text-3); }
.status-dot.is-active { background: var(--accent); }
.status-deadline { margin-left: var(--space-3); color: var(--accent); }
.hero-title { display: block; font-size: var(--font-2xl); font-weight: 600; line-height: 1.35; margin-top: var(--space-2); }
.hero-description { display: block; margin-top: var(--space-3); color: var(--text-2); font-size: var(--font-sm); line-height: 1.7; }
.timezone { white-space: nowrap; }
.loading-title { margin-top: var(--space-5); font-size: var(--font-xl); }
.home-main { padding: 0 var(--space-5); }
.request-card, .submitted-card, .playlist-preview, .waiting-card { padding: var(--space-5); background: var(--surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
.section-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-2); }
.section-title { font-size: var(--font-lg); font-weight: 600; line-height: 1.5; }
.help-link { color: var(--accent); padding: 0; }
.field-group { margin-top: var(--space-4); }
.field-label { display: block; color: var(--text-2); font-size: var(--font-sm); line-height: 1.5; }
.optional-label { margin-left: var(--space-2); color: var(--text-3); font-size: var(--font-xs); }
.input-shell { margin-top: var(--space-2); padding: var(--space-3); border-radius: var(--radius-md); background: var(--surface-2); transition: box-shadow .18s ease; }
.input-shell.is-focused { box-shadow: var(--focus-ring); }
.form-input { width: 100%; height: var(--space-6); padding: 0; background: transparent; color: var(--text-1); font-size: var(--font-md); line-height: var(--space-6); caret-color: var(--accent); }
.home-placeholder { color: var(--placeholder); -webkit-text-fill-color: var(--placeholder); opacity: 1; }
.primary-button { display: block; width: 100%; height: 96rpx; line-height: 96rpx; margin-top: var(--space-5); border-radius: var(--radius-pill); background: var(--accent); color: var(--on-accent); font-size: var(--font-lg); font-weight: 500; text-align: center; }
.primary-button.is-loading { background: var(--accent-disabled); color: var(--on-accent); }
.primary-pressed { background: var(--accent-pressed); }
.form-note { display: block; text-align: center; margin-top: var(--space-3); color: var(--text-3); font-size: var(--font-sm); line-height: 1.5; }
.card-eyebrow { display: block; color: var(--accent); font-size: var(--font-sm); font-weight: 500; }
.submitted-song { display: block; font-size: var(--font-xl); font-weight: 500; line-height: 1.5; margin-top: var(--space-3); overflow-wrap: break-word; word-break: break-all; }
.card-description { display: block; margin-top: var(--space-2); font-size: var(--font-sm); color: var(--text-2); line-height: 1.7; }
.submitted-card .card-description { margin-top: var(--space-4); }
.published-badge { padding: var(--space-1) var(--space-2); color: var(--accent); background: var(--accent-weak); font-size: var(--font-xs); border-radius: var(--radius-sm); }
.preview-row { display: flex; align-items: center; gap: var(--space-3); padding-top: var(--space-4); }
.song-number { display: flex; align-items: center; justify-content: center; flex: none; width: var(--space-6); height: var(--space-6); border-radius: var(--radius-pill); background: var(--accent-weak); color: var(--accent); font-size: var(--font-sm); }
.preview-song { flex: 1; min-width: 0; }
.song-title { display: block; color: var(--text-1); font-size: var(--font-md); font-weight: 500; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.song-singer { display: block; color: var(--text-2); font-size: var(--font-sm); line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.song-day { color: var(--text-3); font-size: var(--font-xs); flex: none; }
.empty-description, .schedule-note { display: block; margin-top: var(--space-4); color: var(--text-2); font-size: var(--font-sm); line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.retry-link { color: var(--accent); margin-top: var(--space-2); }
.playlist-entry { box-sizing: border-box; width: 100%; display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); margin-top: var(--space-4); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-sm); text-align: left; line-height: 1.5; }
.entry-pressed { background: var(--surface-2); }
.entry-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; height: 64rpx; border-radius: var(--radius-md); background: var(--accent-weak); color: var(--accent); font-size: var(--font-lg); }
.entry-content { flex: 1; min-width: 0; }
.entry-title { display: block; font-size: var(--font-md); font-weight: 500; color: var(--text-1); }
.entry-description { display: block; margin-top: var(--space-1); font-size: var(--font-sm); color: var(--text-2); }
.entry-arrow { flex: none; font-size: var(--font-lg); color: var(--text-3); }
.opening-note { margin-top: var(--space-4); color: var(--text-3); font-size: var(--font-xs); text-align: center; line-height: 1.6; }
.result-msg { margin-top: var(--space-4); color: var(--accent); font-size: var(--font-sm); text-align: center; line-height: 1.5; }
.home-footer { margin-top: auto; display: flex; align-items: center; justify-content: space-between; padding: var(--space-5); padding-bottom: calc(var(--space-5) + env(safe-area-inset-bottom)); }
.footer-links { display: flex; align-items: center; gap: var(--space-3); }
.footer-separator, .version { color: var(--text-3); font-size: var(--font-sm); }
@keyframes secret-wiggle-a {
  0%, 100% { transform: rotate(0); }
  25% { transform: translateY(var(--lift)) rotate(var(--tilt)) scale(1.06); }
  75% { transform: translateY(var(--lift)) rotate(calc(var(--tilt) * -1)) scale(1.06); }
}
@keyframes secret-wiggle-b {
  0%, 100% { transform: rotate(0); }
  25% { transform: translateY(var(--lift)) rotate(var(--tilt)) scale(1.06); }
  75% { transform: translateY(var(--lift)) rotate(calc(var(--tilt) * -1)) scale(1.06); }
}
