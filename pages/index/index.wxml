<page-meta page-style="{{appearanceStyle}}" />
<view class="home-page {{statusReady && canSubmit && !schedulePublished ? 'is-open' : ''}}">
  <app-navigation variant="{{statusReady && canSubmit && !schedulePublished ? 'open' : 'closed'}}" />
  <view class="test-banner" wx:if="{{isTestMode}}">测试模式 · 当前操作不会写入正式业务集合</view>
  <view class="home-head">
    <view class="brand-row">
      <view class="brand">
        <text class="dice" style="{{diceShakeStyle}}" bindtap="onSecretDiceTap" aria-label="骰子彩蛋">🎲</text>
        <text class="brand-name">WZ随机助手</text>
      </view>
      <appearance-toggle />
      <button class="text-button admin-link" wx:if="{{userInfo.role === 'admin' || userInfo.role === 'superadmin'}}" bindtap="goAdmin" hover-class="text-pressed">管理后台 ›</button>
    </view>
    <block wx:if="{{statusReady && !statusError}}">
      <view class="status-row">
        <text class="status-dot {{canSubmit && !schedulePublished ? 'is-active' : ''}}"></text>
        <text>{{canSubmit && !schedulePublished ? '点歌通道开放中' : '点歌通道已关闭'}}</text>
        <text class="status-deadline num" wx:if="{{canSubmit && !schedulePublished}}">{{hoursLeftText || '管理员临时开放'}}</text>
      </view>
      <text class="hero-title">{{schedulePublished ? '本期歌单已发布' : (hasSubmitted ? '你的点歌，已收到' : (canSubmit ? '这周，想听什么？' : (channelForceClosed ? '点歌通道暂时关闭' : (beforeOpening ? '点歌即将开放' : '本周点歌已结束'))))}}</text>
      <text class="hero-description" wx:if="{{hasSubmitted && !schedulePublished}}">本周无需再次提交。</text>
      <text class="hero-description" wx:elif="{{canSubmit && !schedulePublished}}">每人每周一次，提交后不可修改。</text>
      <text class="hero-description" wx:elif="{{channelForceClosed}}">{{nextOpenText}}</text>
      <text class="hero-description" wx:else>下次开放：<text class="num">{{nextOpenText}}</text></text>
      <text class="submission-count" wx:if="{{totalSubmissions > 0 && !schedulePublished}}">本周已有 <text class="num">{{totalSubmissions}}</text> 人提交</text>
    </block>
    <block wx:else>
      <text class="hero-title loading-title">{{statusError ? '状态暂时未能加载' : '正在获取本周状态…'}}</text>
      <text class="hero-description">{{statusError ? '请刷新重试，也可以先查看已发布歌单。' : '查看点歌开放时间和本期歌单'}}</text>
      <button wx:if="{{statusError}}" class="text-button retry-link" bindtap="onPullDownRefresh">刷新重试 ›</button>
    </block>
  </view>
  <view class="home-main">
    <block wx:if="{{statusReady && !statusError}}">
      <!-- 四个字段及其长度、提交接口和隐藏彩蛋规则均保留。 -->
      <view class="request-card" wx:if="{{canSubmit && !hasSubmitted && !schedulePublished}}">
        <view class="section-heading">
          <text class="section-title">填写本周点歌</text>
          <button class="text-button help-link" bindtap="goHelp" hover-class="text-pressed">点歌说明 ›</button>
        </view>
        <view class="field-group">
          <text class="field-label">本周验证码</text>
          <view class="input-shell {{focusedField === 'weeklyCode' ? 'is-focused' : ''}}">
            <input class="form-input num" placeholder-class="home-placeholder" placeholder="输入本周公布的验证码" value="{{weeklyCode}}" data-field="weeklyCode" bindinput="onInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" maxlength="20" aria-label="本周验证码" />
          </view>
        </view>
        <view class="field-group">
          <text class="field-label">歌名</text>
          <view class="input-shell {{focusedField === 'title' ? 'is-focused' : ''}}">
            <input class="form-input" placeholder-class="home-placeholder" placeholder="例如：稻香" value="{{title}}" data-field="title" bindinput="onInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" maxlength="50" aria-label="歌名" />
          </view>
        </view>
        <view class="field-group">
          <text class="field-label">歌手 / 来源</text>
          <view class="input-shell {{focusedField === 'remark' ? 'is-focused' : ''}}">
            <input class="form-input" placeholder-class="home-placeholder" placeholder="例如：周杰伦" value="{{remark}}" data-field="remark" bindinput="onInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" maxlength="50" aria-label="歌手或来源" />
          </view>
        </view>
        <view class="field-group">
          <text class="field-label">特殊备注<text class="optional-label">选填</text></text>
          <view class="input-shell {{focusedField === 'specialNote' ? 'is-focused' : ''}}">
            <input class="form-input" placeholder-class="home-placeholder" placeholder="例如：希望播放现场版" value="{{specialNote}}" data-field="specialNote" bindinput="onInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" maxlength="50" aria-label="特殊备注，选填" />
          </view>
        </view>
        <button class="primary-button {{loading ? 'is-loading' : ''}}" bindtap="submitRequest" disabled="{{loading}}" hover-class="primary-pressed">{{loading ? '正在提交…' : '提交本周点歌'}}</button>
      </view>
      <view class="submitted-card" wx:elif="{{hasSubmitted && !schedulePublished}}">
        <text class="card-eyebrow">你的点歌</text>
        <text class="submitted-song" user-select>{{submittedTitle}}</text>
        <text class="submitted-singer" wx:if="{{submittedSinger}}" user-select>{{submittedSinger}}</text>
        <view class="submitted-note" wx:if="{{submittedNote}}">
          <text class="submitted-note-label">备注</text>
          <text class="submitted-note-content" user-select>{{submittedNote}}</text>
        </view>
        <text class="card-description">每周日 20:00 后抽取，最终结果以已发布歌单为准。</text>
      </view>
      <!-- 只展示服务端确认已发布的本期排期。 -->
      <view class="playlist-preview" wx:if="{{schedulePublished}}">
        <view class="section-heading">
          <text class="section-title num">{{previewWeekText ? previewWeekText + '期' : '已发布排期'}}</text>
          <text class="playlist-count num">共 {{previewTotal}} 首</text>
        </view>
        <view class="preview-row {{index === 3 ? 'preview-row-faded' : ''}}" wx:for="{{previewSongs}}" wx:key="key">
          <text class="song-number num">{{index + 1}}</text>
          <view class="preview-song">
            <text class="song-title">{{item.title}}</text>
            <text class="song-singer">{{item.singer}}</text>
          </view>
          <text class="song-day">{{item.day}}</text>
        </view>
        <text class="empty-description" wx:if="{{previewTotal === 0}}">本期暂无曲目安排</text>
        <button class="primary-button preview-button" bindtap="goPlaylist" hover-class="primary-pressed">{{previewTotal > 0 ? '查看完整歌单' : '查看本期详情'}} ›</button>
      </view>
      <view class="waiting-card" wx:elif="{{!canSubmit && !hasSubmitted}}">
        <text class="section-title">{{scheduleLoadFailed ? '本期歌单暂时未能加载' : '本期歌单尚未发布'}}</text>
        <text class="card-description">{{scheduleLoadFailed ? '请刷新重试，或进入歌单页查看。' : (beforeOpening ? '开放后可以在这里提交点歌，也可以先听听往期。' : '等待随机抽取与管理员审核，可以先看看往期歌单。')}}</text>
        <button wx:if="{{scheduleLoadFailed}}" class="text-button retry-link" bindtap="onPullDownRefresh">刷新重试 ›</button>
      </view>
    </block>
    <button class="playlist-entry" wx:if="{{!schedulePublished || !statusReady || statusError}}" bindtap="goPlaylist" hover-class="entry-pressed">
      <view class="entry-icon"><image class="entry-icon-image" src="{{themeIcons.musicList}}" mode="aspectFit" aria-hidden="true" /></view>
      <view class="entry-content">
        <text class="entry-title">查看已发布歌单</text>
        <text class="entry-description">查看本期、上一期和上上期</text>
      </view>
      <text class="entry-arrow">›</text>
    </button>
    <button class="playlist-entry" wx:else bindtap="goHistory" hover-class="entry-pressed">
      <view class="entry-icon"><image class="entry-icon-image" src="{{themeIcons.history}}" mode="aspectFit" aria-hidden="true" /></view>
      <view class="entry-content">
        <text class="entry-title">往期歌单</text>
        <text class="entry-description">回看上一期和上上期</text>
      </view>
      <text class="entry-arrow">›</text>
    </button>
    <view class="result-msg" wx:if="{{statusMsg}}">{{statusMsg}}</view>
    <view class="opening-note" wx:if="{{statusReady && !canSubmit && !hasSubmitted && !statusError}}">每周日 8:00–20:00 开放点歌</view>
  </view>
  <view class="home-footer">
    <view class="footer-links">
      <button class="text-button" bindtap="goHelp" hover-class="text-pressed">使用说明</button>
      <text class="footer-separator">·</text>
      <button class="text-button" bindtap="goAbout" hover-class="text-pressed">关于</button>
    </view>
    <text class="version num">v1.9</text>
  </view>
</view>
<privacy-popup id="privacyPopup"></privacy-popup>
<easter-dice id="easterDice" test-mode="{{isTestMode}}" superadmin="{{userInfo.role === 'superadmin'}}" bind:resetgate="onResetDiceGate"></easter-dice>
<include src="../../templates/feedback.wxml" />
