<view class="page">

  <!-- 测试模式横幅 -->
  <view class="test-banner" wx:if="{{isTestMode}}">测试模式 · 当前操作不会写入正式业务集合</view>

  <!-- 头部：标题 + 彩蛋入口 + 管理入口 + 状态 -->
  <view class="head {{canSubmit && !hasSubmitted ? 'is-open' : 'is-closed'}}">
    <view class="brandrow">
      <view class="brand">
        <text class="dice" style="{{diceShakeStyle}}" bindtap="onSecretDiceTap">🎲</text>
        <text class="brandname">WZ随机助手</text>
      </view>
      <view class="gear" wx:if="{{userInfo.role === 'admin' || userInfo.role === 'superadmin'}}" bindtap="goAdmin">⚙️</view>
    </view>

    <!-- 开放中 -->
    <view class="statusline" wx:if="{{canSubmit && !hasSubmitted}}">
      <text class="dot dot-open"></text>
      <text class="stext">通道开放中</text>
      <text class="sep" wx:if="{{hoursLeftText}}">·</text>
      <text class="stext num" wx:if="{{hoursLeftText}}">{{hoursLeftText}}</text>
      <text class="sep" wx:if="{{totalSubmissions > 0}}">·</text>
      <text class="stext num" wx:if="{{totalSubmissions > 0}}">已有 {{totalSubmissions}} 人提交</text>
    </view>

    <!-- 已提交 -->
    <view class="statusline" wx:elif="{{hasSubmitted}}">
      <text class="dot dot-done"></text>
      <text class="stext">本周你已提交</text>
    </view>

    <!-- 关闭 -->
    <block wx:else>
      <view class="statusline">
        <text class="dot dot-off"></text>
        <text class="stext muted">本周点歌已结束</text>
      </view>
      <view class="nextline" wx:if="{{nextOpenText}}">下次开放：<text class="num strong">{{nextOpenText}}</text></view>
    </block>
  </view>

  <!-- ========== 主体：三态之一 ========== -->

  <!-- ① 已提交 -->
  <view class="submitted" wx:if="{{hasSubmitted}}">
    <text class="sub-title">已提交</text>
    <text class="sub-info">{{submittedInfo}}</text>
    <text class="sub-hint">提交已生效，请等待周日晚随机抽取</text>
  </view>

  <!-- ② 开放且未提交：表单直接可见，不需要多点一次 -->
  <view class="form" wx:elif="{{canSubmit}}">
    <view class="field">
      <text class="flabel">本周验证码</text>
      <input
        class="finput num"
        placeholder-class="fplaceholder"
        placeholder="请输入验证码"
        value="{{weeklyCode}}"
        data-field="weeklyCode"
        bindinput="onInput"
        maxlength="20"
      />
    </view>

    <view class="field">
      <text class="flabel">内容名称</text>
      <input
        class="finput"
        placeholder-class="fplaceholder"
        placeholder="例：稻香"
        value="{{title}}"
        data-field="title"
        bindinput="onInput"
        maxlength="50"
      />
    </view>

    <view class="field">
      <text class="flabel">补充说明</text>
      <input
        class="finput"
        placeholder-class="fplaceholder"
        placeholder="例：周杰伦"
        value="{{remark}}"
        data-field="remark"
        bindinput="onInput"
        maxlength="50"
      />
    </view>

    <view class="field">
      <text class="flabel">特殊备注</text>
      <input
        class="finput"
        placeholder-class="fplaceholder"
        placeholder="选填，如要求特定版本"
        value="{{specialNote}}"
        data-field="specialNote"
        bindinput="onInput"
        maxlength="50"
      />
    </view>

    <button class="submit {{loading ? 'is-loading' : ''}}" bindtap="submitRequest" disabled="{{loading}}">
      {{loading ? '提交中…' : '提交'}}
    </button>
    <text class="form-note">每人每周一次，提交后不可修改</text>
  </view>

  <!-- ③ 通道关闭 -->
  <view class="closed-note" wx:else>
    <text class="cn-text">通道每周日 8:00 – 20:00 开放</text>
    <text class="cn-text">可以提前准备好歌名，开放当天再来</text>
  </view>

  <!-- 歌单入口：整块可点 -->
  <view class="entry" bindtap="goPlaylist">
    <view class="entry-ico">♪</view>
    <view class="entry-main">
      <view class="entry-title">
        <text>已发布歌单</text>
        <text class="entry-badge" wx:if="{{schedulePublished}}">新一期已发布</text>
      </view>
      <text class="entry-sub">含本期与往期</text>
    </view>
    <text class="entry-arrow">›</text>
  </view>

  <!-- 底部 -->
  <view class="foot">
    <text class="foot-link" bindtap="goAbout">关于 · 使用说明</text>
    <text class="foot-ver num">v1.9</text>
  </view>

  <!-- 临时提示 -->
  <view class="result-msg" wx:if="{{statusMsg}}">{{statusMsg}}</view>

</view>

<privacy-popup id="privacyPopup"></privacy-popup>
<easter-dice id="easterDice" test-mode="{{isTestMode}}" superadmin="{{userInfo.role === 'superadmin'}}" bind:resetgate="onResetDiceGate"></easter-dice>
