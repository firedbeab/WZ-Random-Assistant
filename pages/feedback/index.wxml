<page-meta page-style="{{appearanceStyle}} {{sheet || _adminDialogVisible ? 'overflow:hidden;' : 'overflow:auto;'}}" />
<import src="../../templates/community.wxml" />
<view class="info-page community"><app-navigation back /><view class="test-mode-banner" wx:if="{{isTestMode}}">测试模式 · 当前反馈与投票仅用于测试</view><view class="info-head"><view class="info-heading-row"><text class="info-title">反馈中心</text><appearance-toggle /></view><text class="info-desc">把使用感受告诉我们，一起决定下一步。</text></view><view class="c-content">
  <view class="c-tabs"><button class="c-tab {{tab === 'feedback' ? 'active' : ''}}" bindtap="switchTab" data-tab="feedback">使用反馈</button><button class="c-tab {{tab === 'polls' ? 'active' : ''}}" bindtap="switchTab" data-tab="polls">功能投票</button></view>
  <view wx:if="{{tab === 'feedback'}}" class="c-motion"><view class="c-card"><text class="c-title">这次想说什么？</text><text class="c-sub">问题、建议都可以。请勿填写密码、手机号等个人敏感信息。</text><view class="c-chips feedback-categories"><button wx:for="{{categories}}" wx:key="*this" class="c-chip {{category === item ? 'active' : ''}}" bindtap="selectCategory" data-category="{{item}}" disabled="{{busy}}">{{item}}</button></view><textarea class="c-field c-textarea" value="{{content}}" bindinput="inputContent" maxlength="500" disabled="{{busy}}" placeholder="发生了什么？或者你希望增加什么功能？" placeholder-class="c-placeholder" /><view class="c-form-meta"><text class="c-caption">附带版本 v{{version}}</text><text class="c-caption">{{content.length}} / 500</text></view><button class="c-primary" bindtap="submit" disabled="{{busy}}">{{busy ? '正在提交…' : '提交反馈'}}</button><text class="c-caption feedback-limit">每分钟最多 1 条，每天最多 3 条</text></view><view class="c-section">我的反馈</view><template is="community-feedback-list" data="{{entries, themeIcons}}" /></view>
  <view wx:else class="c-motion"><text class="c-sub feedback-poll-note">每个话题一人一票，截止前可以修改选择。</text><template is="community-polls" data="{{polls, busy}}" /></view>
  <view wx:if="{{error}}" class="c-state"><text class="c-title">读取失败</text><text class="c-sub">{{error}}</text><button class="c-link" bindtap="retry">重新加载</button></view><view class="c-state" wx:elif="{{loading}}"><text class="c-title">正在加载</text><text class="c-sub">请稍候。</text></view><view class="c-state" wx:elif="{{tab === 'feedback' ? !entries.length : !polls.length}}"><text class="c-title">{{tab === 'feedback' ? '还没有反馈记录' : '暂时没有功能投票'}}</text><text class="c-sub">{{tab === 'feedback' ? '提交后，可以在这里查看进度与回复。' : '有新话题时会在这里展示。'}}</text></view><button wx:if="{{hasMore && !loading}}" class="c-link" bindtap="loadMore">查看更多</button>
</view></view>
<view wx:if="{{sheet}}" class="admin-drawer-mask c-sheet {{sheetClosing ? 'drawer-closing' : ''}}"><view class="drawer-backdrop" catchtap="closeSheet" catchtouchmove="adminDrawerNoop" /><view class="admin-drawer" catchtap="adminDrawerNoop" bindtouchstart="onAdminDrawerTouchStart" bindtouchend="onAdminDrawerTouchEnd" data-close="closeSheet"><view class="drawer-handle" data-drawer-drag="true" catchtouchmove="adminDrawerNoop" /><view class="c-sheet-head c-row c-between"><text class="modal-title">反馈详情</text><text class="c-badge {{detail.status}}">{{detail.statusLabel}}</text></view><scroll-view class="c-sheet-scroll" scroll-y><view class="c-sheet-body"><text class="c-caption">{{detail.category}} · {{detail.date}} · v{{detail.version}}</text><text class="c-text feedback-detail">{{detail.content}}</text><view class="c-reply" wx:if="{{detail.reply}}"><text class="c-label">管理者回复</text><text class="c-text">{{detail.reply}}</text></view><text class="c-sub" wx:else>收到回复后会在这里显示。</text></view></scroll-view><view class="c-sheet-actions"><button class="c-secondary" bindtap="closeSheet">关闭</button></view></view></view>
<privacy-popup id="privacyPopup" /><include src="../../templates/admin-feedback.wxml" />
