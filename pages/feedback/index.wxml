<page-meta page-style="{{appearanceStyle}} {{viewportStyle}} {{sheet || _adminDialogVisible ? 'overflow:hidden;' : 'overflow:auto;'}}" />
<import src="../../templates/community.wxml" />
<view class="info-page community ornament-page" bindtouchstart="onTabTouchStart" bindtouchmove="onTabTouchMove" bindtouchend="onTabTouchEnd" bindtouchcancel="onTabTouchCancel"><app-navigation id="pageNavigation" back parent="/pages/about/index" /><image class="page-ornament" src="{{themeIcons.feedbackDecor}}" mode="aspectFit" aria-hidden="true" /><image class="page-ornament motif-edge" src="{{themeIcons.feedbackDecor}}" mode="aspectFit" aria-hidden="true" /><view class="info-head ornament-head compact-head"><view class="info-heading-row"><text class="info-title">反馈中心</text></view></view><view class="c-content">
  <view class="c-tabs feedback-tabs"><button class="c-tab {{tab === 'feedback' ? 'active' : ''}}" bindtap="switchTab" data-tab="feedback">使用反馈</button><button class="c-tab {{tab === 'polls' ? 'active' : ''}}" bindtap="switchTab" data-tab="polls">功能投票</button><view class="feedback-tab-indicator {{tab === 'polls' ? 'on-polls' : ''}}"><view /></view></view>
  <view wx:if="{{tab === 'feedback'}}" class="c-motion"><text class="feedback-section-note">请勿填写密码、手机号等个人敏感信息。</text><view class="c-card"><text class="c-title">这次想说什么？</text><view class="c-chips feedback-categories"><button wx:for="{{categories}}" wx:key="*this" class="c-chip {{category === item ? 'active' : ''}}" bindtap="selectCategory" data-category="{{item}}" disabled="{{busy}}">{{item}}</button></view><view class="c-input-shell feedback-input-shell {{focusedField === 'feedback-content' ? 'focused' : ''}}"><textarea class="c-field c-textarea" value="{{content}}" bindinput="inputContent" maxlength="500" disabled="{{busy}}" placeholder="发生了什么？或者你希望增加什么功能？" placeholder-class="c-placeholder" bindfocus="onCommunityFieldFocus" bindblur="onCommunityFieldBlur" data-focus-field="feedback-content" id="keyboard-feedback" data-keyboard-target="#keyboard-feedback"  cursor-spacing="24" adjust-position="{{true}}" /></view><view class="c-form-meta"><text class="c-caption">附带版本 v{{version}}</text><text class="c-caption">{{content.length}} / 500</text></view><button class="c-primary" bindtap="submit" disabled="{{busy}}">{{busy ? '正在提交…' : '提交反馈'}}</button></view><button class="c-card c-entry feedback-history-entry" bindtap="goHistory"><view class="c-grow"><text class="c-title">我的反馈</text><text class="c-sub">查看历史记录与回复</text></view><image src="{{themeIcons.chevronRight}}" /></button></view>
  <view wx:else class="c-motion"><text class="feedback-section-note">每个话题一人一票，截止前可以修改选择。</text><template is="community-polls" data="{{polls:activePolls, busy}}" /><text class="c-sub no-active-polls" wx:if="{{!activePolls.length && endedPolls.length}}">暂无进行中的投票。</text><button wx:if="{{endedPolls.length}}" class="ended-toggle" bindtap="toggleEnded" aria-expanded="{{endedExpanded}}"><text>已结束 · {{endedPolls.length}}</text><image class="{{endedExpanded ? 'expanded' : ''}}" src="{{themeIcons.chevron}}" /></button><view class="ended-group {{endedExpanded ? 'expanded' : ''}}" aria-hidden="{{!endedExpanded}}"><view class="ended-group-inner"><template is="community-polls" data="{{polls:endedPolls,busy}}" /></view></view></view>
  <view wx:if="{{error}}" class="c-state"><text class="c-title">读取失败</text><text class="c-sub">{{error}}</text><button class="c-link" bindtap="retry">重新加载</button></view><view class="c-state" wx:elif="{{loading && tab === 'polls'}}"><text class="c-title">正在加载</text><text class="c-sub">请稍候。</text></view><view class="c-state" wx:elif="{{tab === 'polls' && !polls.length}}"><text class="c-title">{{tab === 'feedback' ? '还没有反馈记录' : '暂时没有功能投票'}}</text><text class="c-sub">{{tab === 'feedback' ? '提交后，可以在这里查看进度与回复。' : '有新话题时会在这里展示。'}}</text></view><button wx:if="{{tab === 'polls' && hasMore && !loading}}" class="c-link" bindtap="loadMore">查看更多</button>
</view></view>
<privacy-popup id="privacyPopup" /><include src="../../templates/admin-feedback.wxml" />
